// =============================================================================
//  FILM LAB  |  Kodak Vision negative + print emulation for DaVinci Resolve
//  v1.0
//
//  Pipeline (per pixel):
//    camera log  -> scene linear (Rec.2020 primaries)
//    -> gate weave, vignette, bloom (diffusion), halation   [scene light]
//    -> negative (Vision3/2/1, Eastman EXR / ECN II): H&D curve per layer, interimage colour, grain
//    -> print: printer lights, print stock H&D curve, dye crosstalk
//    -> display encoding (Rec.709 / sRGB / P3-D65)
//
//  The stock data are parametric approximations of the published character
//  of each stock (contrast, latitude, colour, grain), not measured spectral
//  data.  Treat them as starting points and grade on top.
//
//  Requires DaVinci Resolve Studio (DCTL with UI controls + texture access).
// =============================================================================

DEFINE_UI_PARAMS(p_Input, Input, DCTLUI_COMBO_BOX, 0, { IN_DWG, IN_LOGC3, IN_LOGC4, IN_SLOG3, IN_VLOG, IN_LOG3G10, IN_R709 }, { "DaVinci WG / Intermediate", "ARRI LogC3 / AWG3", "ARRI LogC4 / AWG4", "Sony S-Log3 / S-Gamut3.Cine", "Panasonic V-Log / V-Gamut", "RED Log3G10 / RWG", "Rec.709 Gamma 2.4" })
DEFINE_UI_PARAMS(p_Stock, Negative Stock, DCTLUI_COMBO_BOX, 3, { V3_5203, V3_5207, V3_5213, V3_5219, V3_5219NR, V2_5201, V2_5205, V2_5212, V2_5217, V2_5218, V2_5229, V1_5246, V1_5274, V1_5277, V1_5279, V1_5289, E_5247, E_5294, EXR_5245, EXR_5248, EXR_5293, EXR_5296, EXR_5298 }, { "Vision3 50D 5203", "Vision3 250D 5207", "Vision3 200T 5213", "Vision3 500T 5219", "Vision3 500T 5219 no rem-jet", "Vision2 50D 5201", "Vision2 250D 5205", "Vision2 100T 5212", "Vision2 200T 5217", "Vision2 500T 5218", "Vision2 Expression 500T 5229", "Vision 250D 5246", "Vision 200T 5274", "Vision 320T 5277", "Vision 500T 5279", "Vision 800T 5289", "Eastman ECN II 100T 5247", "Eastman 400T 5294", "Eastman EXR 50D 5245", "Eastman EXR 100T 5248", "Eastman EXR 200T 5293", "Eastman EXR 500T 5296", "Eastman EXR 500T 5298" })
DEFINE_UI_PARAMS(p_Print, Print Stock, DCTLUI_COMBO_BOX, 0, { PR_2383, PR_2393, PR_NONE }, { "Kodak Vision 2383", "Kodak Vision Premier 2393", "None - negative only to DWG/DI" })
