#define LOG10_2   0.30102999566f
#define GOLDEN    2.39996322973f
#define GREY      0.18f
#define PT        0.025f    // one printer point in log exposure

// -----------------------------------------------------------------------------
//  Small helpers
// -----------------------------------------------------------------------------

__DEVICE__ float clampf(float x, float a, float b) { return _fminf(_fmaxf(x, a), b); }
__DEVICE__ int clampi(int x, int a, int b) { return x < a ? a : (x > b ? b : x); }
__DEVICE__ float exp10_f(float x) { return _powf(10.0f, x); }

// log10(1 + 10^z) without overflow
__DEVICE__ float softplus10(float z)
{
    if (z > 0.0f) return z + _log10f(1.0f + exp10_f(-z));
    return _log10f(1.0f + exp10_f(z));
}

__DEVICE__ float3 mul3(float3 c, float a, float b, float d, float e, float f, float g, float h, float i, float j)
{
    return make_float3(a * c.x + b * c.y + d * c.z,
                       e * c.x + f * c.y + g * c.z,
                       h * c.x + i * c.y + j * c.z);
}

__DEVICE__ float3 add3(float3 a, float3 b) { return make_float3(a.x + b.x, a.y + b.y, a.z + b.z); }
__DEVICE__ float3 scale3(float3 a, float s) { return make_float3(a.x * s, a.y * s, a.z * s); }
__DEVICE__ float luma2020(float3 c) { return 0.2627f * c.x + 0.6780f * c.y + 0.0593f * c.z; }

// -----------------------------------------------------------------------------
//  Hashing / noise
// -----------------------------------------------------------------------------

__DEVICE__ unsigned int hash_u(unsigned int x)
{
    x ^= x >> 16; x *= 0x7feb352dU;
    x ^= x >> 15; x *= 0x846ca68bU;
    x ^= x >> 16;
    return x;
}

__DEVICE__ unsigned int hash3u(int x, int y, unsigned int s)
{
    return hash_u((unsigned int)x + hash_u((unsigned int)y + hash_u(s)));
}

// uniform in [-1, 1]
__DEVICE__ float hash_sf(int x, int y, unsigned int s)
{
    return (float)(hash3u(x, y, s) & 0x00FFFFFFU) * (2.0f / 16777215.0f) - 1.0f;
}

// approx. gaussian, unit variance (sum of three uniforms)
__DEVICE__ float hash_gauss(int x, int y, unsigned int s)
{
    float a = hash_sf(x, y, s);
    float b = hash_sf(x, y, s + 0x9e3779b9U);
    float c = hash_sf(x, y, s + 0x3c6ef372U);
    return (a + b + c);
}

// smooth value noise on a lattice of spacing `size` pixels
__DEVICE__ float value_noise(float px, float py, float size, unsigned int s)
{
    float fx = px / size, fy = py / size;
    float ix = _floorf(fx), iy = _floorf(fy);
    float tx = fx - ix, ty = fy - iy;
    tx = tx * tx * (3.0f - 2.0f * tx);
    ty = ty * ty * (3.0f - 2.0f * ty);
    int x0 = (int)ix, y0 = (int)iy;
    float a = hash_gauss(x0,     y0,     s);
    float b = hash_gauss(x0 + 1, y0,     s);
    float c = hash_gauss(x0,     y0 + 1, s);
    float d = hash_gauss(x0 + 1, y0 + 1, s);
    return (a + (b - a) * tx) + ((c + (d - c) * tx) - (a + (b - a) * tx)) * ty;
}

// film grain: two octaves of dye-cloud noise plus a fine silver component
__DEVICE__ float grain_noise(float px, float py, float size, unsigned int s)
{
    float n = 0.75f * value_noise(px, py, size, s)
            + 0.45f * value_noise(px + 17.3f, py - 9.1f, size * 0.55f, s ^ 0x51ed270bU)
            + 0.30f * hash_gauss((int)px, (int)py, s ^ 0xa3c59ac3U);
    return n * 0.85f;
}

// -----------------------------------------------------------------------------
//  Input decoding -> scene linear, Rec.2020 primaries
// -----------------------------------------------------------------------------

__DEVICE__ float di_to_lin(float x)
{
    if (x <= 0.02740668f) return x / 10.44426855f;
    return _exp2f(x / 0.07329248f - 7.0f) - 0.0075f;
}

__DEVICE__ float lin_to_di(float x)
{
    if (x <= 0.00262409f) return x * 10.44426855f;
    return (_log2f(x + 0.0075f) + 7.0f) * 0.07329248f;
}

__DEVICE__ float logc3_to_lin(float x)
{
    if (x > 0.149658f) return (exp10_f((x - 0.385537f) / 0.247190f) - 0.052272f) / 5.555556f;
    return (x - 0.092809f) / 5.367655f;
}

__DEVICE__ float logc4_to_lin(float x)
{
    const float a = 2231.82630906f;      // (2^18 - 16) / 117.45
    const float b = 0.90713587f;         // (1023 - 95) / 1023
    const float c = 0.09286413f;         // 95 / 1023
    const float s = 0.11384993f;
    const float t = -0.01805699f;
    if (x >= 0.0f) return (_exp2f(14.0f * (x - c) / b + 6.0f) - 64.0f) / a;
    return x * s + t;
}

__DEVICE__ float slog3_to_lin(float x)
{
    if (x >= 171.2102946929f / 1023.0f) return exp10_f((x * 1023.0f - 420.0f) / 261.5f) * 0.19f - 0.01f;
    return (x * 1023.0f - 95.0f) * 0.01125f / (171.2102946929f - 95.0f);
}

__DEVICE__ float vlog_to_lin(float x)
{
    if (x < 0.181f) return (x - 0.125f) / 5.6f;
    return exp10_f((x - 0.598206f) / 0.241514f) - 0.00873f;
}

__DEVICE__ float log3g10_to_lin(float x)
{
    if (x < 0.0f) return x / 15.1927f - 0.01f;
    return (exp10_f(x / 0.224282f) - 1.0f) / 155.975327f - 0.01f;
}

__DEVICE__ float3 input_to_lin2020(float3 c, int input)
{
    if (input == IN_DWG) {
        c = make_float3(di_to_lin(c.x), di_to_lin(c.y), di_to_lin(c.z));
        return mul3(c, 1.13030218f, -0.02039285f, -0.10990933f,
                      -0.02554706f,  1.31084932f, -0.28530226f,
                      -0.09259861f, -0.16465302f,  1.25725163f);
    }
    if (input == IN_LOGC3) {
        c = make_float3(logc3_to_lin(c.x), logc3_to_lin(c.y), logc3_to_lin(c.z));
        return mul3(c, 0.99068812f, 0.09253966f, -0.08322777f,
                       0.04663223f, 1.18752685f, -0.23415909f,
                       0.00140359f, -0.09460200f, 1.09319842f);
    }
    if (input == IN_LOGC4) {
        c = make_float3(logc4_to_lin(c.x), logc4_to_lin(c.y), logc4_to_lin(c.z));
        return mul3(c, 1.11946906f, -0.05519563f, -0.06427343f,
                      -0.05848446f,  1.17673493f, -0.11825048f,
                       0.00154745f, -0.03113533f,  1.02958788f);
    }
    if (input == IN_SLOG3) {
        c = make_float3(slog3_to_lin(c.x), slog3_to_lin(c.y), slog3_to_lin(c.z));
        return mul3(c, 0.96004634f, 0.11953298f, -0.07957932f,
                      -0.05223948f, 1.26430575f, -0.21206627f,
                      -0.02884051f, -0.05952097f, 1.08836147f);
    }
    if (input == IN_VLOG) {
        c = make_float3(vlog_to_lin(c.x), vlog_to_lin(c.y), vlog_to_lin(c.z));
        return mul3(c, 1.07635314f, -0.01314478f, -0.06320837f,
                      -0.03186184f,  1.15105266f, -0.11919082f,
                      -0.00793202f, -0.03480314f,  1.04273516f);
    }
    if (input == IN_LOG3G10) {
        c = make_float3(log3g10_to_lin(c.x), log3g10_to_lin(c.y), log3g10_to_lin(c.z));
        return mul3(c, 1.18043085f, -0.09403956f, -0.08639129f,
                      -0.02801732f,  1.31144204f, -0.28342472f,
                      -0.07435952f, -0.36207760f,  1.43643712f);
    }
    // Rec.709 display-referred
    c = make_float3(_powf(_fmaxf(c.x, 0.0f), 2.4f), _powf(_fmaxf(c.y, 0.0f), 2.4f), _powf(_fmaxf(c.z, 0.0f), 2.4f));
    return mul3(c, 0.62740390f, 0.32928304f, 0.04331307f,
                   0.06909729f, 0.91954040f, 0.01136232f,
                   0.01639144f, 0.08801331f, 0.89559525f);
}

__DEVICE__ float3 fetch(__TEXTURE__ tR, __TEXTURE__ tG, __TEXTURE__ tB, int x, int y, int w, int h, int input)
{
    x = clampi(x, 0, w - 1);
    y = clampi(y, 0, h - 1);
    float3 c = make_float3(_tex2D(tR, x, y), _tex2D(tG, x, y), _tex2D(tB, x, y));
    return input_to_lin2020(c, input);
}

__DEVICE__ float3 fetch_bilinear(__TEXTURE__ tR, __TEXTURE__ tG, __TEXTURE__ tB, float x, float y, int w, int h, int input)
{
    float fx = _floorf(x), fy = _floorf(y);
    float tx = x - fx, ty = y - fy;
    int x0 = (int)fx, y0 = (int)fy;
    float3 a = fetch(tR, tG, tB, x0,     y0,     w, h, input);
    float3 b = fetch(tR, tG, tB, x0 + 1, y0,     w, h, input);
    float3 c = fetch(tR, tG, tB, x0,     y0 + 1, w, h, input);
    float3 d = fetch(tR, tG, tB, x0 + 1, y0 + 1, w, h, input);
    float3 top = add3(scale3(a, 1.0f - tx), scale3(b, tx));
    float3 bot = add3(scale3(c, 1.0f - tx), scale3(d, tx));
    return add3(scale3(top, 1.0f - ty), scale3(bot, ty));
}

// soft-knee highlight extraction above `thr` (linear), keeps hue
__DEVICE__ float3 highlights(float3 c, float thr, float y)
{
    float k = 0.5f * thr;
    float e;
    if (y <= thr - k) e = 0.0f;
    else if (y < thr + k) e = (y - thr + k) * (y - thr + k) / (4.0f * k);
    else e = y - thr;
    float f = e / _fmaxf(y, 1e-6f);
    return make_float3(_fmaxf(c.x, 0.0f) * f, _fmaxf(c.y, 0.0f) * f, _fmaxf(c.z, 0.0f) * f);
}

// -----------------------------------------------------------------------------
//  Stock data
// -----------------------------------------------------------------------------

typedef struct {
    float gr, gg, gb;    // negative gamma per layer (R, G, B)
    float xt, kt;        // toe: log E (rel. 18% grey) where the straight line meets base; toe softness
    float emax, ks;      // shoulder: max. log E range above toe; shoulder softness
    float sat;           // interimage effect (colour density)
    float trg, trb, tgr, tgb, tbr, tbg;   // interlayer hue coupling
    float grain;         // rms granularity at mid grey (density)
    float gsize;         // relative grain size
    float hal;           // halation factor (rem-jet efficiency)
    float hrad;          // halation spread factor
} NegStock;

__DEVICE__ NegStock neg_stock(int id)
{
    NegStock s;
    // Vision3 defaults: long straight line, very late shoulder, fine grain
    s.gr = 0.60f; s.gg = 0.60f; s.gb = 0.60f;
    s.xt = -1.17f; s.kt = 0.26f; s.emax = 3.70f; s.ks = 0.30f;
    s.sat = 0.25f;
    s.trg = 0.0f; s.trb = 0.0f; s.tgr = 0.0f; s.tgb = 0.0f; s.tbr = 0.0f; s.tbg = 0.0f;
    s.grain = 0.010f; s.gsize = 1.0f; s.hal = 1.0f; s.hrad = 1.0f;

    if (id == V3_5203) {          // 50D: finest grain, clean, slightly richer colour
        s.gr = 0.61f; s.gg = 0.60f; s.gb = 0.60f;
        s.sat = 0.30f; s.trg = 0.02f; s.tbg = 0.02f;
        s.grain = 0.0055f; s.gsize = 0.80f; s.hal = 0.85f;
    } else if (id == V3_5207) {   // 250D: neutral-warm, fine grain
        s.gr = 0.61f; s.gg = 0.60f; s.gb = 0.59f;
        s.sat = 0.26f; s.trg = 0.03f; s.tgr = 0.01f;
        s.grain = 0.0085f; s.gsize = 0.95f; s.hal = 0.95f;
    } else if (id == V3_5213) {   // 200T: firm shadows, rich skin
        s.gr = 0.61f; s.gg = 0.61f; s.gb = 0.59f;
        s.xt = -1.13f; s.kt = 0.24f;
        s.sat = 0.27f; s.trg = 0.03f; s.tbr = -0.01f;
        s.grain = 0.0080f; s.gsize = 0.95f; s.hal = 1.0f;
    } else if (id == V3_5219) {   // 500T: soft toe, cool shadows, visible grain
        s.gr = 0.60f; s.gg = 0.60f; s.gb = 0.57f;
        s.xt = -1.22f; s.kt = 0.30f;
        s.sat = 0.22f; s.tgb = 0.02f; s.tbg = 0.03f;
        s.grain = 0.0130f; s.gsize = 1.20f; s.hal = 1.15f;
    } else if (id == V3_5219NR) { // 500T without anti-halation backing (CineStill-style)
        s.gr = 0.60f; s.gg = 0.60f; s.gb = 0.57f;
        s.xt = -1.22f; s.kt = 0.30f;
        s.sat = 0.22f; s.tgb = 0.02f; s.tbg = 0.03f;
        s.grain = 0.0140f; s.gsize = 1.25f; s.hal = 3.0f; s.hrad = 2.2f;
    } else if (id == V2_5201) {   // Vision2: earlier shoulder, a touch more contrast
        s.gr = 0.63f; s.gg = 0.62f; s.gb = 0.62f;
        s.xt = -1.12f; s.kt = 0.22f; s.emax = 3.10f; s.ks = 0.28f;
        s.sat = 0.28f; s.trg = 0.02f; s.tbg = 0.02f;
        s.grain = 0.0065f; s.gsize = 0.85f; s.hal = 0.9f;
    } else if (id == V2_5205) {
        s.gr = 0.63f; s.gg = 0.62f; s.gb = 0.61f;
        s.xt = -1.12f; s.kt = 0.22f; s.emax = 3.10f; s.ks = 0.28f;
        s.sat = 0.25f; s.trg = 0.03f; s.tgr = 0.015f;
        s.grain = 0.0105f; s.gsize = 1.0f; s.hal = 1.0f;
    } else if (id == V2_5212) {
        s.gr = 0.63f; s.gg = 0.63f; s.gb = 0.61f;
        s.xt = -1.10f; s.kt = 0.22f; s.emax = 3.10f; s.ks = 0.28f;
        s.sat = 0.27f; s.trg = 0.02f;
        s.grain = 0.0090f; s.gsize = 0.95f; s.hal = 1.0f;
    } else if (id == V2_5217) {
        s.gr = 0.63f; s.gg = 0.62f; s.gb = 0.60f;
        s.xt = -1.12f; s.kt = 0.23f; s.emax = 3.10f; s.ks = 0.28f;
        s.sat = 0.26f; s.trg = 0.03f; s.tbr = -0.01f;
        s.grain = 0.0110f; s.gsize = 1.05f; s.hal = 1.05f;
    } else if (id == V2_5218) {
        s.gr = 0.62f; s.gg = 0.62f; s.gb = 0.59f;
        s.xt = -1.17f; s.kt = 0.27f; s.emax = 3.10f; s.ks = 0.28f;
        s.sat = 0.22f; s.tgb = 0.02f; s.tbg = 0.03f;
        s.grain = 0.0160f; s.gsize = 1.25f; s.hal = 1.15f;
    } else if (id == V2_5229) {   // Expression 500T: low contrast, low saturation
        s.gr = 0.54f; s.gg = 0.54f; s.gb = 0.52f;
        s.xt = -1.30f; s.kt = 0.32f; s.emax = 3.30f; s.ks = 0.32f;
        s.sat = 0.10f; s.tgb = 0.015f;
        s.grain = 0.0150f; s.gsize = 1.25f; s.hal = 1.15f;
    } else if (id == V1_5246) {   // Vision (1st gen): shorter scale, more grain
        s.gr = 0.64f; s.gg = 0.63f; s.gb = 0.62f;
        s.xt = -1.08f; s.kt = 0.20f; s.emax = 2.80f; s.ks = 0.26f;
        s.sat = 0.28f; s.trg = 0.03f; s.tgr = 0.02f;
        s.grain = 0.0125f; s.gsize = 1.05f; s.hal = 1.05f;
    } else if (id == V1_5274) {
        s.gr = 0.64f; s.gg = 0.64f; s.gb = 0.62f;
        s.xt = -1.08f; s.kt = 0.20f; s.emax = 2.80f; s.ks = 0.26f;
        s.sat = 0.29f; s.trg = 0.03f; s.tbr = -0.01f;
        s.grain = 0.0130f; s.gsize = 1.05f; s.hal = 1.05f;
    } else if (id == V1_5277) {   // 320T: designed as a low-contrast stock
        s.gr = 0.56f; s.gg = 0.56f; s.gb = 0.55f;
        s.xt = -1.25f; s.kt = 0.30f; s.emax = 3.00f; s.ks = 0.30f;
        s.sat = 0.16f; s.tgb = 0.01f;
        s.grain = 0.0145f; s.gsize = 1.15f; s.hal = 1.1f;
    } else if (id == V1_5279) {
        s.gr = 0.63f; s.gg = 0.63f; s.gb = 0.60f;
        s.xt = -1.12f; s.kt = 0.25f; s.emax = 2.80f; s.ks = 0.26f;
        s.sat = 0.24f; s.tgb = 0.02f; s.tbg = 0.03f;
        s.grain = 0.0185f; s.gsize = 1.30f; s.hal = 1.2f;
    } else if (id == V1_5289) {   // 800T: push-stock look, heavy grain
        s.gr = 0.62f; s.gg = 0.62f; s.gb = 0.58f;
        s.xt = -1.10f; s.kt = 0.28f; s.emax = 2.70f; s.ks = 0.26f;
        s.sat = 0.20f; s.tgb = 0.03f; s.tbg = 0.03f;
        s.grain = 0.0250f; s.gsize = 1.45f; s.hal = 1.3f;
    } else if (id == E_5247) {    // ECN II 100T (70s-80s): short scale, punchy warm colour
        s.gr = 0.66f; s.gg = 0.65f; s.gb = 0.62f;
        s.xt = -1.02f; s.kt = 0.20f; s.emax = 2.40f; s.ks = 0.24f;
        s.sat = 0.34f; s.trg = 0.04f; s.tgr = 0.02f; s.tbg = 0.02f;
        s.grain = 0.0150f; s.gsize = 1.15f; s.hal = 1.3f;
    } else if (id == E_5294) {    // 400T (80s): fast, grainy, softer colour
        s.gr = 0.64f; s.gg = 0.63f; s.gb = 0.59f;
        s.xt = -1.05f; s.kt = 0.24f; s.emax = 2.40f; s.ks = 0.24f;
        s.sat = 0.24f; s.trg = 0.03f; s.tgb = 0.02f; s.tbg = 0.03f;
        s.grain = 0.0240f; s.gsize = 1.45f; s.hal = 1.35f;
    } else if (id == EXR_5245) {  // EXR (late 80s-90s): finer grain, still shorter scale than Vision
        s.gr = 0.65f; s.gg = 0.64f; s.gb = 0.63f;
        s.xt = -1.06f; s.kt = 0.20f; s.emax = 2.60f; s.ks = 0.25f;
        s.sat = 0.31f; s.trg = 0.03f; s.tbg = 0.02f;
        s.grain = 0.0090f; s.gsize = 0.90f; s.hal = 1.1f;
    } else if (id == EXR_5248) {
        s.gr = 0.65f; s.gg = 0.64f; s.gb = 0.62f;
        s.xt = -1.06f; s.kt = 0.21f; s.emax = 2.60f; s.ks = 0.25f;
        s.sat = 0.30f; s.trg = 0.03f; s.tgr = 0.015f;
        s.grain = 0.0120f; s.gsize = 1.05f; s.hal = 1.15f;
    } else if (id == EXR_5293) {
        s.gr = 0.65f; s.gg = 0.65f; s.gb = 0.62f;
        s.xt = -1.07f; s.kt = 0.21f; s.emax = 2.60f; s.ks = 0.25f;
        s.sat = 0.29f; s.trg = 0.03f; s.tbr = -0.01f;
        s.grain = 0.0150f; s.gsize = 1.15f; s.hal = 1.2f;
    } else if (id == EXR_5296) {  // 500T: the late-80s / 90s night stock
        s.gr = 0.64f; s.gg = 0.63f; s.gb = 0.59f;
        s.xt = -1.10f; s.kt = 0.25f; s.emax = 2.50f; s.ks = 0.25f;
        s.sat = 0.25f; s.tgb = 0.02f; s.tbg = 0.03f;
        s.grain = 0.0210f; s.gsize = 1.35f; s.hal = 1.3f;
    } else if (id == EXR_5298) {  // 500T: higher contrast, punchier than 5296
        s.gr = 0.67f; s.gg = 0.66f; s.gb = 0.63f;
        s.xt = -1.06f; s.kt = 0.23f; s.emax = 2.50f; s.ks = 0.25f;
        s.sat = 0.29f; s.trg = 0.02f; s.tgb = 0.02f; s.tbg = 0.02f;
        s.grain = 0.0200f; s.gsize = 1.35f; s.hal = 1.3f;
    }
    return s;
}

typedef struct {
    float gr, gg, gb;    // print gamma per layer
    float target;        // density of mid grey above Dmin
    float kt;            // toe softness (highlight roll-off)
    float sc, us;        // extra contrast in the lower scale (shadows) and where it starts
    float dmax, ks;      // max density above Dmin; shoulder softness (blacks)
    float3 m0, m1, m2;   // negative dye -> print exposure crosstalk (rows sum to 1)
    float3 n0, n1, n2;   // print dye unwanted absorptions (rows sum to 1)
} PrintStock;

__DEVICE__ PrintStock print_stock(int id)
{
    PrintStock p;
    if (id == PR_2393) {          // Vision Premier: higher contrast, denser blacks, purer colour
        p.gr = 2.95f; p.gg = 2.88f; p.gb = 2.80f;
        p.target = 0.86f; p.kt = 0.28f; p.sc = 0.80f; p.us = 0.22f; p.dmax = 4.4f; p.ks = 0.30f;
        p.m0 = make_float3(0.979f, 0.018f, 0.003f);
        p.m1 = make_float3(0.012f, 0.973f, 0.015f);
        p.m2 = make_float3(0.003f, 0.021f, 0.976f);
        p.n0 = make_float3(0.985f, 0.012f, 0.003f);
        p.n1 = make_float3(0.015f, 0.970f, 0.015f);
        p.n2 = make_float3(0.003f, 0.027f, 0.970f);
    } else {                      // 2383: the classic release print
        p.gr = 2.72f; p.gg = 2.66f; p.gb = 2.56f;
        p.target = 0.82f; p.kt = 0.30f; p.sc = 0.60f; p.us = 0.25f; p.dmax = 3.9f; p.ks = 0.32f;
        p.m0 = make_float3(0.970f, 0.024f, 0.006f);
        p.m1 = make_float3(0.015f, 0.961f, 0.024f);
        p.m2 = make_float3(0.003f, 0.033f, 0.964f);
        p.n0 = make_float3(0.979f, 0.015f, 0.006f);
        p.n1 = make_float3(0.021f, 0.958f, 0.021f);
        p.n2 = make_float3(0.006f, 0.036f, 0.958f);
    }
    return p;
}

// -----------------------------------------------------------------------------
//  Characteristic (H&D) curves
// -----------------------------------------------------------------------------

// Exposure-equivalent density: straight line through `xt` with soft toe and
// soft shoulder at `emax`.  Multiply by gamma to get density above base.
__DEVICE__ float hd_curve(float x, float xt, float kt, float emax, float ks)
{
    float e = kt * softplus10((x - xt) / kt);
    return e - ks * softplus10((e - emax) / ks);
}

// print curve: as above plus extra lower-scale contrast for dense blacks
__DEVICE__ float print_curve(float u, float ut, float kt, float sc, float us, float emax, float ks)
{
    float e = kt * softplus10((u - ut) / kt) + sc * 0.15f * softplus10((u - us) / 0.15f);
    return e - ks * softplus10((e - emax) / ks);
}

// solve the print toe position so that u = 0 lands exactly on `target`
__DEVICE__ float print_toe(float target, float kt, float sc, float us, float emax, float ks)
{
    float ut = -target;
    for (int i = 0; i < 4; i++) ut += print_curve(0.0f, ut, kt, sc, us, emax, ks) - target;
    return ut;
}

// -----------------------------------------------------------------------------
//  Blur kernels (Vogel spiral, per-pixel rotation to hide sampling pattern)
// -----------------------------------------------------------------------------

__DEVICE__ float3 bloom_blur(__TEXTURE__ tR, __TEXTURE__ tG, __TEXTURE__ tB, float cx, float cy, int w, int h, int input,
                             float sigma, float thr, float gain, int n, float rot)
{
    float3 acc = make_float3(0.0f, 0.0f, 0.0f);
    float wsum = 0.0f;
    for (int i = 0; i < n; i++) {
        float r = _sqrtf(((float)i + 0.5f) / (float)n) * 2.6f;
        float a = (float)i * GOLDEN + rot;
        int sx = (int)(cx + _cosf(a) * r * sigma + 0.5f);
        int sy = (int)(cy + _sinf(a) * r * sigma + 0.5f);
        float3 c = scale3(fetch(tR, tG, tB, sx, sy, w, h, input), gain);
        float wt = _expf(-0.5f * r * r);
        acc = add3(acc, scale3(highlights(c, thr, luma2020(c)), wt));
        wsum += wt;
    }
    return scale3(acc, 1.0f / wsum);
}

// halation: light reflected from the film base back into the red (and some
// green) layer.  Exponential profile, driven mostly by red-band exposure.
__DEVICE__ float halation_blur(__TEXTURE__ tR, __TEXTURE__ tG, __TEXTURE__ tB, float cx, float cy, int w, int h, int input,
                               float sigma, float thr, float gain, int n, float rot)
{
    float acc = 0.0f, wsum = 0.0f;
    for (int i = 0; i < n; i++) {
        float r = _sqrtf(((float)i + 0.5f) / (float)n) * 4.0f;
        float a = (float)i * GOLDEN + rot;
        int sx = (int)(cx + _cosf(a) * r * sigma + 0.5f);
        int sy = (int)(cy + _sinf(a) * r * sigma + 0.5f);
        float3 c = scale3(fetch(tR, tG, tB, sx, sy, w, h, input), gain);
        float src = _fmaxf(0.75f * c.x + 0.25f * c.y, 0.0f);
        float k = 0.5f * thr, e;
        if (src <= thr - k) e = 0.0f;
        else if (src < thr + k) e = (src - thr + k) * (src - thr + k) / (4.0f * k);
        else e = src - thr;
        float wt = _expf(-r);
        acc += e * wt;
        wsum += wt;
    }
    return acc / wsum;
}

// -----------------------------------------------------------------------------
//  Main
// -----------------------------------------------------------------------------

__DEVICE__ float3 transform(int p_Width, int p_Height, int p_X, int p_Y, __TEXTURE__ p_TexR, __TEXTURE__ p_TexG, __TEXTURE__ p_TexB)
{
    const float W = (float)p_Width;
    const float H = (float)p_Height;

    // ---- per-frame seed: hash a sparse grid of source pixels so grain,
    //      breath and weave change whenever the picture changes
    unsigned int seed = hash_u(0x1234567U + (unsigned int)p_Seed * 0x9e3779b9U);
    if (p_Animate) {
        for (int j = 0; j < 4; j++) {
            for (int i = 0; i < 4; i++) {
                int sx = (int)((i + 0.5f) * W * 0.25f);
                int sy = (int)((j + 0.5f) * H * 0.25f);
                float v = _tex2D(p_TexR, sx, sy) + _tex2D(p_TexG, sx, sy) * 1.37f + _tex2D(p_TexB, sx, sy) * 1.91f;
                seed = hash_u(seed ^ (unsigned int)(clampf(v, 0.0f, 16.0f) * 262143.0f));
            }
        }
    }
    float fr0 = (float)(hash_u(seed ^ 0x68e31da4U) & 0xFFFFU) / 32767.5f - 1.0f;
    float fr1 = (float)(hash_u(seed ^ 0xb5297a4dU) & 0xFFFFU) / 32767.5f - 1.0f;
    float fr2 = (float)(hash_u(seed ^ 0x1b56c4e9U) & 0xFFFFU) / 32767.5f - 1.0f;
    float fr3 = (float)(hash_u(seed ^ 0x7f4a7c15U) & 0xFFFFU) / 32767.5f - 1.0f;
    float fr4 = (float)(hash_u(seed ^ 0x2545f491U) & 0xFFFFU) / 32767.5f - 1.0f;

    // ---- format: frame width in mm drives grain and halation scale
    float frameMM = 24.89f;
    if (p_Format == FMT_65) frameMM = 52.48f;
    else if (p_Format == FMT_S16) frameMM = 12.52f;
    else if (p_Format == FMT_S8) frameMM = 5.79f;
    float pxPerMM = W / frameMM;

    int nSamples = 48;
    if (p_Quality == Q_LOW) nSamples = 24;
    else if (p_Quality == Q_HIGH) nSamples = 96;

    NegStock ns = neg_stock(p_Stock);
    float expGain = _exp2f(p_Exposure);

    // ---- gate weave (sub-pixel image shift per frame)
    float cx = (float)p_X, cy = (float)p_Y;
    float3 E;
    if (p_Weave > 0.0f && p_Animate) {
        cx += fr0 * p_Weave * 0.0006f * W;
        cy += fr1 * p_Weave * 0.0010f * W;
        E = fetch_bilinear(p_TexR, p_TexG, p_TexB, cx, cy, p_Width, p_Height, p_Input);
    } else {
        E = fetch(p_TexR, p_TexG, p_TexB, p_X, p_Y, p_Width, p_Height, p_Input);
    }
    E = scale3(E, expGain);

    float rot = (float)(hash3u(p_X, p_Y, 0x5bd1e995U) & 0xFFFFU) * (6.2831853f / 65535.0f);

    // ---- bloom / diffusion: redistributes highlight energy (energy conserving)
    if (p_BloomAmount > 0.0f) {
        float thr = GREY * _exp2f(p_BloomThreshold);
        float sigma = _fmaxf(p_BloomRadius * 0.01f * W, 0.5f);
        float3 b = bloom_blur(p_TexR, p_TexG, p_TexB, cx, cy, p_Width, p_Height, p_Input, sigma, thr, expGain, nSamples, rot);
        float3 hl = highlights(E, thr, luma2020(E));
        E = add3(E, scale3(add3(b, scale3(hl, -1.0f)), p_BloomAmount));
    }

    // ---- halation: added to red / some green exposure
    if (p_HalAmount > 0.0f) {
        float thr = GREY * _exp2f(p_HalThreshold);
        float sigma = _fmaxf(0.09f * p_HalRadius * ns.hrad * pxPerMM, 0.5f);
        float hv = halation_blur(p_TexR, p_TexG, p_TexB, cx, cy, p_Width, p_Height, p_Input, sigma, thr, expGain, nSamples, rot + 1.7f);
        hv *= 0.30f * p_HalAmount * ns.hal;
        E.x += hv;
        E.y += hv * 0.30f * p_HalWarmth;
        E.z += hv * 0.02f;
    }

    // ---- vignette (lens falloff, in stops at the corners)
    if (p_Vignette > 0.0f) {
        float dx = ((float)p_X - 0.5f * W) / (0.5f * W);
        float dy = ((float)p_Y - 0.5f * H) / (0.5f * W);
        float r2 = (dx * dx + dy * dy) / (1.0f + (H * H) / (W * W));
        E = scale3(E, _exp2f(-p_Vignette * r2 * r2 * 0.6f - p_Vignette * r2 * 0.4f));
    }

    // =========================================================================
    //  NEGATIVE
    // =========================================================================
    // spectral sensitivity overlap of the three layers: each layer also sees
    // part of its neighbours' light (linear, hue preserving desaturation)
    {
        float y = luma2020(E);
        E = make_float3(y + (E.x - y) * 0.78f, y + (E.y - y) * 0.78f, y + (E.z - y) * 0.78f);
    }

    float xr = _log10f(_fmaxf(E.x, 1e-7f) / GREY);
    float xg = _log10f(_fmaxf(E.y, 1e-7f) / GREY);
    float xb = _log10f(_fmaxf(E.z, 1e-7f) / GREY);

    // exposure-equivalent density above toe, relative to mid grey
    float e0 = hd_curve(0.0f, ns.xt, ns.kt, ns.emax, ns.ks);
    float qr = hd_curve(xr, ns.xt, ns.kt, ns.emax, ns.ks) - e0;
    float qg = hd_curve(xg, ns.xt, ns.kt, ns.emax, ns.ks) - e0;
    float qb = hd_curve(xb, ns.xt, ns.kt, ns.emax, ns.ks) - e0;

    // interimage effect + interlayer coupling (neutral preserving);
    // Color Density scales the whole colour signal: 1 = stock, 0 = monochrome
    float cd = p_ColorDensity;
    float s = 1.0f + ns.sat;
    float qm = (qr + qg + qb) * (1.0f / 3.0f);
    float ir = qm + cd * (s * (qr - qm) + (ns.trg * (qg - qr) + ns.trb * (qb - qr)));
    float ig = qm + cd * (s * (qg - qm) + (ns.tgr * (qr - qg) + ns.tgb * (qb - qg)));
    float ib = qm + cd * (s * (qb - qm) + (ns.tbr * (qr - qb) + ns.tbg * (qg - qb)));

    // density relative to mid grey (per layer gamma -> colour crossover)
    float dr = ns.gr * ir, dg = ns.gg * ig, db = ns.gb * ib;

    // ---- grain: dye clouds in each layer, rms grows with density
    if (p_GrainAmount > 0.0f) {
        float gsize = _fmaxf(0.012f * pxPerMM * ns.gsize * p_GrainSize, 0.6f);
        float px = (float)p_X, py = (float)p_Y;
        unsigned int gs = hash_u(seed ^ 0x27d4eb2fU);
        float nm = grain_noise(px, py, gsize, gs);
        float nr = grain_noise(px, py, gsize, gs ^ 0x165667b1U);
        float ng = grain_noise(px, py, gsize * 0.9f, gs ^ 0xd3a2646cU);
        float nb = grain_noise(px, py, gsize * 1.15f, gs ^ 0xfd7046c5U);
        float ch = p_GrainChroma;
        float norm = 1.0f / _sqrtf((1.0f - ch) * (1.0f - ch) + ch * ch);
        nr = (nm * (1.0f - ch) + nr * ch) * norm;
        ng = (nm * (1.0f - ch) + ng * ch) * norm;
        nb = (nm * (1.0f - ch) + nb * ch) * norm;

        float dgR = -ns.gr * ns.xt, dgG = -ns.gg * ns.xt, dgB = -ns.gb * ns.xt;   // grey density above base
        float amp = ns.grain * p_GrainAmount * _sqrtf(24.89f / frameMM);   // smaller frame = more enlargement
        dr += nr * amp * 1.00f * _sqrtf(_fmaxf(dr + dgR, 0.0f) / dgR + 0.12f) * 0.94f;
        dg += ng * amp * 0.90f * _sqrtf(_fmaxf(dg + dgG, 0.0f) / dgG + 0.12f) * 0.94f;
        db += nb * amp * 1.35f * _sqrtf(_fmaxf(db + dgB, 0.0f) / dgB + 0.12f) * 0.94f;
    }

    // =========================================================================
    //  NEGATIVE ONLY: re-linearise the negative (scan) and return DWG / DI
    // =========================================================================
    if (p_Print == PR_NONE) {
        // density -> exposure along the ideal straight line; the toe, shoulder
        // and colour of the stock stay baked in
        float floorv = exp10_f(ns.xt);
        float lr = GREY * (exp10_f(dr / ns.gr + e0 + ns.xt) - floorv) / (1.0f - floorv);
        float lg = GREY * (exp10_f(dg / ns.gg + e0 + ns.xt) - floorv) / (1.0f - floorv);
        float lb = GREY * (exp10_f(db / ns.gb + e0 + ns.xt) - floorv) / (1.0f - floorv);
        float3 o = mul3(make_float3(lr, lg, lb),
                        0.89211212f, 0.02436918f, 0.08351870f,
                        0.03261660f, 0.78613752f, 0.18124588f,
                        0.06997705f, 0.10474949f, 0.82527346f);
        return make_float3(lin_to_di(o.x), lin_to_di(o.y), lin_to_di(o.z));
    }

    // =========================================================================
    //  PRINT
    // =========================================================================
    PrintStock ps = print_stock(p_Print);

    // light through the negative (relative to mid grey), mixed by the print
    // stock's spectral sensitivities
    float tr = exp10_f(-dr), tg = exp10_f(-dg), tb = exp10_f(-db);
    float er = ps.m0.x * tr + ps.m0.y * tg + ps.m0.z * tb;
    float eg = ps.m1.x * tr + ps.m1.y * tg + ps.m1.z * tb;
    float eb = ps.m2.x * tr + ps.m2.y * tg + ps.m2.z * tb;

    // printer lights: + = brighter / more of that colour
    float breath = p_Animate ? p_Breath : 0.0f;
    float ur = _log10f(_fmaxf(er, 1e-9f)) - PT * (p_PrintExp + p_PrintR) + breath * (0.012f * fr2 + 0.006f * fr3);
    float ug = _log10f(_fmaxf(eg, 1e-9f)) - PT * (p_PrintExp + p_PrintG) + breath * (0.012f * fr2 + 0.006f * fr4);
    float ub = _log10f(_fmaxf(eb, 1e-9f)) - PT * (p_PrintExp + p_PrintB) + breath * (0.012f * fr2 - 0.006f * fr3);

    float pgr = ps.gr * p_PrintContrast, pgg = ps.gg * p_PrintContrast, pgb = ps.gb * p_PrintContrast;
    float tgtR = ps.target / pgr, tgtG = ps.target / pgg, tgtB = ps.target / pgb;
    float utR = print_toe(tgtR, ps.kt, ps.sc, ps.us, ps.dmax / pgr, ps.ks / pgr);
    float utG = print_toe(tgtG, ps.kt, ps.sc, ps.us, ps.dmax / pgg, ps.ks / pgg);
    float utB = print_toe(tgtB, ps.kt, ps.sc, ps.us, ps.dmax / pgb, ps.ks / pgb);

    float Dr = pgr * print_curve(ur, utR, ps.kt, ps.sc, ps.us, ps.dmax / pgr, ps.ks / pgr);
    float Dg = pgg * print_curve(ug, utG, ps.kt, ps.sc, ps.us, ps.dmax / pgg, ps.ks / pgg);
    float Db = pgb * print_curve(ub, utB, ps.kt, ps.sc, ps.us, ps.dmax / pgb, ps.ks / pgb);

    // print dye unwanted absorptions
    float Pr = ps.n0.x * Dr + ps.n0.y * Dg + ps.n0.z * Db;
    float Pg = ps.n1.x * Dr + ps.n1.y * Dg + ps.n1.z * Db;
    float Pb = ps.n2.x * Dr + ps.n2.y * Dg + ps.n2.z * Db;

    // projected light, white = clear print (Dmin)
    float flare = p_Flare * 0.002f;
    float3 L = make_float3(exp10_f(-Pr), exp10_f(-Pg), exp10_f(-Pb));
    L = make_float3((L.x + flare) / (1.0f + flare), (L.y + flare) / (1.0f + flare), (L.z + flare) / (1.0f + flare));

    // =========================================================================
    //  OUTPUT
    // =========================================================================
    float3 o;
    if (p_Output == OUT_P3) {
        o = mul3(L, 1.34357825f, -0.28217967f, -0.06139858f,
                   -0.06529745f,  1.07578792f, -0.01049046f,
                    0.00282179f, -0.01959849f,  1.01677671f);
    } else {
        o = mul3(L, 1.66049100f, -0.58764114f, -0.07284986f,
                   -0.12455047f,  1.13289990f, -0.00834942f,
                   -0.01815076f, -0.10057890f,  1.11872966f);
    }
    // gamut compression: pull negative components toward luminance
    float Y = luma2020(L);
    float mn = _fminf(o.x, _fminf(o.y, o.z));
    if (mn < 0.0f && Y > 0.0f) {
        float t = Y / (Y - mn);
        o = make_float3(Y + (o.x - Y) * t, Y + (o.y - Y) * t, Y + (o.z - Y) * t);
    }
    o = make_float3(clampf(o.x, 0.0f, 1.0f), clampf(o.y, 0.0f, 1.0f), clampf(o.z, 0.0f, 1.0f));

    float g = 1.0f / 2.4f;
    if (p_Output == OUT_SRGB) g = 1.0f / 2.2f;
    else if (p_Output == OUT_P3) g = 1.0f / 2.6f;
    return make_float3(_powf(o.x, g), _powf(o.y, g), _powf(o.z, g));
}
