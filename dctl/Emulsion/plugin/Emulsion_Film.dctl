// =============================================================================
//  EMULSION FILM  |  Kodak / Eastman negative + print emulation for DaVinci Resolve
//  v1.0
//
//    camera log -> scene linear (Rec.2020)            Emulsion_lib/input.h
//    -> primaries on scene light                      Emulsion_lib/grade.h
//    -> negative: spectral layer exposure,            Emulsion_lib/negative.h
//       interimage, Status M curves
//    -> print: spectral printing onto 2383,           Emulsion_lib/print.h
//       timing to LAD, Status A curves, projection
//    -> display encoding, SDR or HDR                  Emulsion_lib/output.h
//
//  Spectral data from Kodak's data sheets: Emulsion_lib/film_data.h
//  (generated by tools/build_data.py).  Texture (grain, halation, bloom,
//  MTF) is the next node: Emulsion_Texture.dctl.
//
//  Keep the Emulsion_lib folder next to this file.  Requires DaVinci Resolve Studio.
// =============================================================================

DEFINE_UI_PARAMS(p_InGamut, Input Color Space, DCTLUI_COMBO_BOX, 0, { G_DWG, G_AWG3, G_AWG4, G_SG3C, G_VG, G_RWG, G_CCG, G_709, G_2020 }, { "DaVinci Wide Gamut", "ARRI Wide Gamut 3", "ARRI Wide Gamut 4", "Sony S-Gamut3.Cine", "Panasonic V-Gamut", "RED Wide Gamut RGB", "Canon Cinema Gamut", "Rec.709", "Rec.2020" })
DEFINE_UI_PARAMS(p_InGamma, Input Gamma, DCTLUI_COMBO_BOX, 0, { T_DI, T_LOGC3, T_LOGC4, T_SLOG3, T_VLOG, T_LOG3G10, T_CLOG2, T_CLOG3, T_G24, T_LIN, T_CINEON }, { "DaVinci Intermediate", "ARRI LogC3", "ARRI LogC4", "Sony S-Log3", "Panasonic V-Log", "RED Log3G10", "Canon Log 2", "Canon Log 3", "Gamma 2.4", "Linear", "Cineon Log (film scan)" })
DEFINE_UI_PARAMS(p_Stock, Negative Stock, DCTLUI_COMBO_BOX, 1, { V3_5203, V3_5207, V3_5213, V3_5219, V3_5219NR, V2_5201, V2_5205, V2_5212, V2_5217, V2_5218, V2_5229, V1_5246, V1_5274, V1_5277, V1_5279, V1_5289, E_5247, E_5294, EXR_5245, EXR_5248, EXR_5293, EXR_5296, EXR_5298, NEG_NONE }, { "Vision3 50D 5203", "Vision3 250D 5207", "Vision3 200T 5213", "Vision3 500T 5219", "Vision3 500T 5219 no rem-jet", "Vision2 50D 5201", "Vision2 250D 5205", "Vision2 100T 5212", "Vision2 200T 5217", "Vision2 500T 5218", "Vision2 Expression 500T 5229", "Vision 250D 5246", "Vision 200T 5274", "Vision 320T 5277", "Vision 500T 5279", "Vision 800T 5289", "Eastman ECN II 100T 5247", "Eastman 400T 5294", "Eastman EXR 50D 5245", "Eastman EXR 100T 5248", "Eastman EXR 200T 5293", "Eastman EXR 500T 5296", "Eastman EXR 500T 5298", "None - print only" })
DEFINE_UI_PARAMS(p_Print, Print Stock, DCTLUI_COMBO_BOX, 0, { PR_2383, PR_2383D60, PR_2383D55, PR_2393 }, { "Kodak 2383 D65", "Kodak 2383 D60", "Kodak 2383 D55", "Kodak 2393" })
DEFINE_UI_PARAMS(p_DRT, DRT, DCTLUI_COMBO_BOX, 0, { DRT_FILM, DRT_NEUTRAL, DRT_OFF, DRT_CINEON }, { "Film Print", "Neutral", "Off - DWG / Intermediate", "Off - Cineon Log (for Resolve 2383 LUT)" })
DEFINE_UI_PARAMS(p_Output, Output, DCTLUI_COMBO_BOX, 0, { OUT_709, OUT_SRGB, OUT_P3, OUT_PQ, OUT_HLG }, { "Rec.709 Gamma 2.4", "sRGB / Rec.709 Gamma 2.2", "P3-D65 Gamma 2.6", "Rec.2100 PQ (HDR)", "Rec.2100 HLG (HDR)" })

DEFINE_UI_PARAMS(p_Strength, Strength, DCTLUI_SLIDER_FLOAT, 1.0, 0.0, 1.0, 0.01)
DEFINE_UI_PARAMS(p_NegStrength, Negative Strength, DCTLUI_SLIDER_FLOAT, 1.0, 0.0, 1.0, 0.01)
DEFINE_UI_PARAMS(p_PrintStrength, Print Strength, DCTLUI_SLIDER_FLOAT, 1.0, 0.0, 1.0, 0.01)

DEFINE_UI_PARAMS(p_Exposure, Exposure, DCTLUI_SLIDER_FLOAT, 0.0, -4.0, 4.0, 0.05)
DEFINE_UI_PARAMS(p_Contrast, Contrast, DCTLUI_SLIDER_FLOAT, 1.0, 0.5, 1.5, 0.01)
DEFINE_UI_PARAMS(p_Pivot, Pivot, DCTLUI_SLIDER_FLOAT, 0.0, -2.0, 2.0, 0.05)
DEFINE_UI_PARAMS(p_Highlights, Highlights, DCTLUI_SLIDER_FLOAT, 0.0, -1.0, 1.0, 0.01)
DEFINE_UI_PARAMS(p_Shadows, Shadows, DCTLUI_SLIDER_FLOAT, 0.0, -1.0, 1.0, 0.01)
DEFINE_UI_PARAMS(p_Temp, Temperature K, DCTLUI_SLIDER_FLOAT, 6500.0, 2000.0, 15000.0, 50.0)
DEFINE_UI_PARAMS(p_Tint, Tint, DCTLUI_SLIDER_FLOAT, 0.0, -1.0, 1.0, 0.01)
DEFINE_UI_PARAMS(p_Saturation, Saturation, DCTLUI_SLIDER_FLOAT, 1.0, 0.0, 2.0, 0.01)
DEFINE_UI_PARAMS(p_SkinHue, Skin Hue, DCTLUI_SLIDER_FLOAT, 0.0, -1.0, 1.0, 0.01)
DEFINE_UI_PARAMS(p_SkinSat, Skin Saturation, DCTLUI_SLIDER_FLOAT, 1.0, 0.0, 2.0, 0.01)

DEFINE_UI_PARAMS(p_PushPull, Push Pull, DCTLUI_SLIDER_FLOAT, 0.0, -2.0, 3.0, 0.1)
DEFINE_UI_PARAMS(p_ColorDensity, Color Density, DCTLUI_SLIDER_FLOAT, 1.0, 0.0, 2.5, 0.01)
DEFINE_UI_PARAMS(p_Interimage, Interimage, DCTLUI_SLIDER_FLOAT, 1.0, 0.0, 2.0, 0.01)

DEFINE_UI_PARAMS(p_PrintExp, Print Exposure, DCTLUI_SLIDER_FLOAT, 0.0, -12.0, 12.0, 0.5)
DEFINE_UI_PARAMS(p_PrintR, Printer Light R, DCTLUI_SLIDER_FLOAT, 0.0, -12.0, 12.0, 0.5)
DEFINE_UI_PARAMS(p_PrintG, Printer Light G, DCTLUI_SLIDER_FLOAT, 0.0, -12.0, 12.0, 0.5)
DEFINE_UI_PARAMS(p_PrintB, Printer Light B, DCTLUI_SLIDER_FLOAT, 0.0, -12.0, 12.0, 0.5)
DEFINE_UI_PARAMS(p_PrintContrast, Print Contrast, DCTLUI_SLIDER_FLOAT, 1.0, 0.6, 1.4, 0.01)
DEFINE_UI_PARAMS(p_Crosstalk, Print Crosstalk, DCTLUI_SLIDER_FLOAT, 1.0, 0.0, 2.0, 0.01)
DEFINE_UI_PARAMS(p_DyeSat, Dye Saturation, DCTLUI_SLIDER_FLOAT, 1.0, 0.0, 2.0, 0.01)
DEFINE_UI_PARAMS(p_DyeC, Dye Sat Cyan, DCTLUI_SLIDER_FLOAT, 1.0, 0.0, 2.0, 0.01)
DEFINE_UI_PARAMS(p_DyeM, Dye Sat Magenta, DCTLUI_SLIDER_FLOAT, 1.0, 0.0, 2.0, 0.01)
DEFINE_UI_PARAMS(p_DyeY, Dye Sat Yellow, DCTLUI_SLIDER_FLOAT, 1.0, 0.0, 2.0, 0.01)
DEFINE_UI_PARAMS(p_BlackToe, Black Toe, DCTLUI_SLIDER_FLOAT, 0.0, -1.0, 1.0, 0.01)
DEFINE_UI_PARAMS(p_ShadowRoll, Shadow Roll-off, DCTLUI_SLIDER_FLOAT, 0.0, -1.0, 1.0, 0.01)
DEFINE_UI_PARAMS(p_HighlightRoll, Highlight Roll-off, DCTLUI_SLIDER_FLOAT, 0.0, -1.0, 1.0, 0.01)
DEFINE_UI_PARAMS(p_PrintBleach, Print Bleach Bypass, DCTLUI_SLIDER_FLOAT, 0.0, 0.0, 1.0, 0.01)

DEFINE_UI_PARAMS(p_Flare, Projection Flare, DCTLUI_SLIDER_FLOAT, 0.0, 0.0, 2.0, 0.01)
DEFINE_UI_PARAMS(p_FlareHue, Flare Tint Hue, DCTLUI_SLIDER_FLOAT, 30.0, 0.0, 360.0, 1.0)
DEFINE_UI_PARAMS(p_FlareTint, Flare Tint Amount, DCTLUI_SLIDER_FLOAT, 0.0, 0.0, 1.0, 0.01)
DEFINE_UI_PARAMS(p_HdrPeak, HDR Peak Luminance, DCTLUI_SLIDER_FLOAT, 1000.0, 100.0, 4000.0, 10.0)
DEFINE_UI_PARAMS(p_HdrGrey, HDR Grey nits, DCTLUI_SLIDER_FLOAT, 18.0, 5.0, 40.0, 0.5)

DEFINE_UI_PARAMS(p_NeutralNeg, Neutral Negative Curve, DCTLUI_CHECK_BOX, 0)
DEFINE_UI_PARAMS(p_NegBleach, Negative Bleach Bypass, DCTLUI_CHECK_BOX, 0)
DEFINE_UI_PARAMS(p_NeutralPrint, Neutral Print Curve, DCTLUI_CHECK_BOX, 0)
DEFINE_UI_PARAMS(p_ShowCurve, Show Curve, DCTLUI_CHECK_BOX, 0)

#include "Emulsion_lib/core.h"
#include "Emulsion_lib/film_data.h"
#include "Emulsion_lib/input.h"
#include "Emulsion_lib/grade.h"
#include "Emulsion_lib/negative.h"
#include "Emulsion_lib/print.h"
#include "Emulsion_lib/output.h"

// scene light (after the primaries) -> output code values.  film = 0 renders
// the neutral reference that Strength blends towards: ideal negative, neutral DRT.
__DEVICE__ float3 render(float3 E, int film, NegStock ns, NegCtl nc, PrintCtl pc)
{
    if (!film) { nc.strength = 0.0f; nc.bleach = 0; }
    Negative n = expose_negative(E, ns, nc);
    if (p_DRT == DRT_CINEON) return negative_to_cineon(n);

    float3 scene = scan_negative(n, E);
    if (p_DRT == DRT_OFF) return scene_to_dwg_di(scene);

    float3 neutral = encode_output(neutral_drt(scene), p_Output, p_HdrPeak, p_HdrGrey);
    if (p_DRT != DRT_FILM || !film || pc.strength <= 0.0f) return neutral;
    float3 print = encode_output(print_film(n, pc), p_Output, p_HdrPeak, p_HdrGrey);
    return mix3(neutral, print, pc.strength);
}

__DEVICE__ float3 transform(int p_Width, int p_Height, int p_X, int p_Y, float p_R, float p_G, float p_B)
{
    Grade g;
    g.exposure = p_Exposure; g.contrast = p_Contrast; g.pivot = p_Pivot;
    g.highlights = p_Highlights; g.shadows = p_Shadows;
    g.temp = p_Temp; g.tint = p_Tint; g.saturation = p_Saturation;
    g.skinHue = p_SkinHue; g.skinSat = p_SkinSat;

    NegCtl nc;
    nc.pushPull = p_PushPull; nc.colorDensity = p_ColorDensity; nc.interimage = p_Interimage;
    nc.strength = p_NegStrength; nc.neutral = p_NeutralNeg; nc.bleach = p_NegBleach;
    NegStock ns = develop(neg_stock(p_Stock), nc.pushPull, nc.neutral);

    PrintCtl pc;
    pc.stock = p_Print; pc.crosstalk = p_Crosstalk;
    pc.exposure = p_PrintExp; pc.lightR = p_PrintR; pc.lightG = p_PrintG; pc.lightB = p_PrintB;
    pc.contrast = p_PrintContrast;
    pc.dyeSat = p_DyeSat; pc.dyeC = p_DyeC; pc.dyeM = p_DyeM; pc.dyeY = p_DyeY;
    pc.blackToe = p_BlackToe; pc.shadowRoll = p_ShadowRoll; pc.highlightRoll = p_HighlightRoll;
    pc.bleach = p_PrintBleach; pc.neutral = p_NeutralPrint;
    pc.flare = p_Flare; pc.flareHue = p_FlareHue; pc.flareTint = p_FlareTint;
    pc.strength = p_PrintStrength;

    CurveBox box = curve_box(p_ShowCurve, p_Width, p_Height, p_X, p_Y);
    float3 E = box.inside ? f3(GREY * _exp2f(curve_stops(box)))
                          : camera_to_scene(make_float3(p_R, p_G, p_B), p_InGamut, p_InGamma);
    E = grade(E, g);

    float3 res = render(E, 1, ns, nc, pc);
    if (p_Strength < 1.0f) res = mix3(render(E, 0, ns, nc, pc), res, p_Strength);
    if (box.inside) res = curve_plot(box, res);
    return res;
}
