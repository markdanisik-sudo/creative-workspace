#define PRINT_CURVE_R 0.05f, 4.12155f, 1.25885f, 4.74464f, 1.01845f, 1.02913f   // dmin, dmax, x0, gamma, toe, shoulder
#define PRINT_CURVE_G 0.05f, 4.16857f, 0.96356f, 4.0816f, 1.01577f, 1.01192f   // dmin, dmax, x0, gamma, toe, shoulder
#define PRINT_CURVE_B 0.09f, 4.04148f, 0.7646f, 3.54111f, 0.612892f, 0.619076f   // dmin, dmax, x0, gamma, toe, shoulder
#define PRINT_CURVE_AVG 4.12245f, 0.882371f, 0.886709f   // gamma, toe, shoulder averaged (neutral print curve)
// interimage (DIR) effect: during development each layer is pushed away from
// (or pulled toward) the others.  Kodak's sheets do not show it; fitted to a
// ColorChecker on a real Vision3 250D scan (scanner tone curve fitted too),
// scaled to 0.6 of the scan fit: the strength that matches best through the
// 2383 print (the rest of the scan's saturation belongs to the scanner)
#define II_RG  0.0097f
#define II_RB  0.2045f
#define II_GR  0.0759f
#define II_GB  -0.0772f
#define II_BR  0.2350f
#define II_BG  -0.1913f

#define LAD_R     1.09f         // laboratory aim density of the 18% grey on 2383 (Status A)
#define LAD_G     1.06f
#define LAD_B     1.03f

__DEVICE__ float3 mat3x3(float3 c, float a, float b, float d, float e, float f, float g, float h, float i, float j)
{
    return mul3(c, a, b, d, e, f, g, h, i, j);
}

// Rec.2020 scene light -> exposure of the three negative layers (R, G, B
// sensitive), from the stock's spectral sensitivity under its balance light
__DEVICE__ float3 layer_exposure(float3 c, int m)
{
    if (m == 0) return mat3x3(c, MSENS_50D);
    if (m == 1) return mat3x3(c, MSENS_250D);
    if (m == 2) return mat3x3(c, MSENS_500T);
    return c;
}

__DEVICE__ float3 layer_to_scene(float3 c, int m)
{
    if (m == 0) return mat3x3(c, MSENS_INV_50D);
    if (m == 1) return mat3x3(c, MSENS_INV_250D);
    if (m == 2) return mat3x3(c, MSENS_INV_500T);
    return c;
}

// -----------------------------------------------------------------------------
//  Negative stocks: Status M characteristic curve per layer
// -----------------------------------------------------------------------------

typedef struct {
    float3 dmin, g, xt, kt, emax, ks;    // density = dmin + g * hd(log E): base, gamma, toe, toe softness, shoulder, shoulder softness
    int mat;                             // spectral sensitivity: 0 = 50D, 1 = 250D, 2 = 500T, 3 = ideal
    float cd;                            // colour separation relative to Vision3
} NegStock;

__DEVICE__ NegStock neg_stock(int id)
{
    NegStock s;
    if (id == V3_5203) {  // 50D: finest grain, clean, slightly richer colour
        // Kodak datasheet, measured
        s.dmin = make_float3(0.172656f, 0.579906f, 0.850837f); s.g = make_float3(0.499302f, 0.587238f, 0.565878f); s.xt = make_float3(-1.54435f, -1.49689f, -1.5054f);
        s.kt = make_float3(0.276559f, 0.326198f, 0.443257f); s.emax = make_float3(3.51573f, 3.54435f, 3.50415f); s.ks = make_float3(0.751461f, 0.682186f, 0.549574f);
        s.mat = 0; s.cd = 1.0f;
    } else if (id == V3_5207) {  // 250D: neutral-warm, fine grain
        // Kodak datasheet, measured
        s.dmin = make_float3(0.173916f, 0.575303f, 0.845082f); s.g = make_float3(0.486541f, 0.568031f, 0.547918f); s.xt = make_float3(-1.47085f, -1.45175f, -1.44924f);
        s.kt = make_float3(0.595967f, 0.576569f, 0.487185f); s.emax = make_float3(3.58817f, 3.66566f, 3.5717f); s.ks = make_float3(0.920814f, 0.894463f, 0.814529f);
        s.mat = 1; s.cd = 1.0f;
    } else if (id == V3_5213) {  // 200T: firm shadows, rich skin
        // Vision3 spectral data, tone from the stock character
        s.dmin = make_float3(0.173916f, 0.575303f, 0.845082f); s.g = make_float3(0.49465f, 0.577498f, 0.538786f); s.xt = make_float3(-1.13f, -1.13f, -1.13f);
        s.kt = make_float3(0.24f, 0.24f, 0.24f); s.emax = make_float3(3.7f, 3.7f, 3.7f); s.ks = make_float3(0.3f, 0.3f, 0.3f);
        s.mat = 2; s.cd = 1.016f;
    } else if (id == V3_5219) {  // 500T: soft toe, cool shadows, visible grain
        // Kodak datasheet, measured
        s.dmin = make_float3(0.225449f, 0.618194f, 0.913884f); s.g = make_float3(0.591876f, 0.67373f, 0.653235f); s.xt = make_float3(-1.17826f, -1.21857f, -1.24644f);
        s.kt = make_float3(0.288002f, 0.228172f, 0.389684f); s.emax = make_float3(3.13276f, 3.18167f, 3.28701f); s.ks = make_float3(0.798581f, 0.573326f, 0.773002f);
        s.mat = 2; s.cd = 1.0f;
    } else if (id == V3_5219NR) {  // 500T without anti-halation backing (CineStill-style)
