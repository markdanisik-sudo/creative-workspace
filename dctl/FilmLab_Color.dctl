// =============================================================================
//  FILM LAB COLOR  |  Kodak Vision3 negative + 2383 print emulation for DaVinci Resolve
//  v4.0 (spectral, audited)
//
//  Order follows the photographic chain (see dctl/FILMLAB_V4.md):
//    camera log -> scene linear (Rec.2020)
//    -> exposure, white balance (camera / filter, before the film)
//    -> layer exposure: root polynomial fitted on the stock's spectral
//       sensitivity under its balance light
//    -> halation: base reflection re-exposes the red (and some green) layer
//    -> development: Status M H&D curve per layer, push / pull
//    -> interimage on exposure-equivalent density, film saturation, layer density
//    -> negative grain (density)
//    -> printing: printer lamp through the negative's dyes (36 bands) onto the
//       2383 layers, timed so a normal grey prints to LAD; printer lights
//    -> 2383 Status A H&D curves, dye saturation
//    -> projection through the print dyes -> CIE 1931 -> D65 -> output
//
//  Data: Kodak data sheets for 5203, 5213, 5207, 5219 and 2383 (digitised),
//  CIE standard tables, ColorChecker fits; generated by tools/export.py.
//  Vision3 50D, 200T, 250D, 500T and 2383 are all from Kodak data.
//
//  The previous version is dctl/backup/FilmLab_Color_v3.dctl.
//  Requires DaVinci Resolve Studio.
// =============================================================================

DEFINE_UI_PARAMS(p_InGamut, Input Color Space, DCTLUI_COMBO_BOX, 6, { G_DWG, G_AWG3, G_AWG4, G_SG3C, G_VG, G_RWG, G_CCG, G_709, G_2020 }, { "DaVinci Wide Gamut", "ARRI Wide Gamut 3", "ARRI Wide Gamut 4", "Sony S-Gamut3.Cine", "Panasonic V-Gamut", "RED Wide Gamut RGB", "Canon Cinema Gamut", "Rec.709", "Rec.2020" })
DEFINE_UI_PARAMS(p_InGamma, Input Gamma, DCTLUI_COMBO_BOX, 6, { T_DI, T_LOGC3, T_LOGC4, T_SLOG3, T_VLOG, T_LOG3G10, T_CLOG2, T_CLOG3, T_G24, T_LIN, T_CINEON }, { "DaVinci Intermediate", "ARRI LogC3", "ARRI LogC4", "Sony S-Log3", "Panasonic V-Log", "RED Log3G10", "Canon Log 2", "Canon Log 3", "Gamma 2.4", "Linear", "Cineon Log (film scan)" })
DEFINE_UI_PARAMS(p_Levels, Input Data Levels, DCTLUI_COMBO_BOX, 0, { LV_FULL, LV_VIDEO }, { "Full - log code / 1023 (as Resolve CST)", "Video - legal range scaled to 0-1" })
DEFINE_UI_PARAMS(p_Stock, Negative Stock, DCTLUI_COMBO_BOX, 2, { V3_5203, V3_5213, V3_5207, V3_5219, V3_5219NR, NEG_NONE }, { "Vision3 50D 5203", "Vision3 200T 5213", "Vision3 250D 5207", "Vision3 500T 5219", "Vision3 500T 5219 no rem-jet", "None - print only" })
DEFINE_UI_PARAMS(p_Format, Film Format, DCTLUI_COMBO_BOX, 1, { FMT_65, FMT_35, FMT_S16, FMT_S8 }, { "65 mm", "35 mm", "Super 16", "Super 8" })
DEFINE_UI_PARAMS(p_Print, Print Stock, DCTLUI_COMBO_BOX, 0, { PR_2383, PR_2383D60, PR_2383D55, PR_2393 }, { "Kodak 2383 (D65 projection)", "Kodak 2383 (D60 projection, estimated)", "Kodak 2383 (D55 projection, estimated)", "Kodak 2393 (estimated from 2383)" })
DEFINE_UI_PARAMS(p_DRT, DRT, DCTLUI_COMBO_BOX, 0, { DRT_FILM, DRT_NEUTRAL, DRT_OFF, DRT_CINEON }, { "Film Print", "Neutral (no print)", "Off - negative scan to DWG / Intermediate", "Off - Cineon printing density" })
DEFINE_UI_PARAMS(p_Output, Output, DCTLUI_COMBO_BOX, 0, { OUT_709, OUT_SRGB, OUT_P3, OUT_PQ, OUT_HLG }, { "Rec.709 Gamma 2.4", "sRGB / Rec.709 Gamma 2.2", "P3-D65 Gamma 2.6", "Rec.2100 PQ (HDR)", "Rec.2100 HLG (HDR)" })

DEFINE_UI_PARAMS(p_Exposure, Exposure, DCTLUI_SLIDER_FLOAT, 0.0, -4.0, 4.0, 0.05)
DEFINE_UI_PARAMS(p_Temp, Temperature K, DCTLUI_SLIDER_FLOAT, 6500.0, 2000.0, 15000.0, 50.0)
DEFINE_UI_PARAMS(p_Tint, Tint, DCTLUI_SLIDER_FLOAT, 0.0, -1.0, 1.0, 0.01)

DEFINE_UI_PARAMS(p_Push, Push Pull, DCTLUI_SLIDER_FLOAT, 0.0, -1.0, 2.0, 0.1)
DEFINE_UI_PARAMS(p_Interimage, Interimage, DCTLUI_SLIDER_FLOAT, 1.0, 0.0, 2.0, 0.01)
DEFINE_UI_PARAMS(p_FilmSat, Film Saturation, DCTLUI_SLIDER_FLOAT, 1.0, 0.0, 2.0, 0.01)
DEFINE_UI_PARAMS(p_LayerC, Layer Density Cyan, DCTLUI_SLIDER_FLOAT, 1.0, 0.8, 1.2, 0.005)
DEFINE_UI_PARAMS(p_LayerM, Layer Density Magenta, DCTLUI_SLIDER_FLOAT, 1.0, 0.8, 1.2, 0.005)
DEFINE_UI_PARAMS(p_LayerY, Layer Density Yellow, DCTLUI_SLIDER_FLOAT, 1.0, 0.8, 1.2, 0.005)
DEFINE_UI_PARAMS(p_NegBleach, Negative Bleach Bypass, DCTLUI_SLIDER_FLOAT, 0.0, 0.0, 1.0, 0.01)
DEFINE_UI_PARAMS(p_Halation, Halation, DCTLUI_SLIDER_FLOAT, 1.0, 0.0, 4.0, 0.01)
DEFINE_UI_PARAMS(p_Grain, Grain, DCTLUI_SLIDER_FLOAT, 1.0, 0.0, 3.0, 0.01)

DEFINE_UI_PARAMS(p_PrintExp, Print Exposure, DCTLUI_SLIDER_FLOAT, 0.0, -12.0, 12.0, 0.5)
DEFINE_UI_PARAMS(p_PrintR, Printer Light R, DCTLUI_SLIDER_FLOAT, 0.0, -12.0, 12.0, 0.5)
DEFINE_UI_PARAMS(p_PrintG, Printer Light G, DCTLUI_SLIDER_FLOAT, 0.0, -12.0, 12.0, 0.5)
DEFINE_UI_PARAMS(p_PrintB, Printer Light B, DCTLUI_SLIDER_FLOAT, 0.0, -12.0, 12.0, 0.5)
DEFINE_UI_PARAMS(p_PrintContrast, Print Contrast, DCTLUI_SLIDER_FLOAT, 1.0, 0.8, 1.2, 0.01)
DEFINE_UI_PARAMS(p_DyeSat, Print Dye Saturation, DCTLUI_SLIDER_FLOAT, 1.0, 0.0, 2.0, 0.01)
DEFINE_UI_PARAMS(p_Crosstalk, Print Crosstalk, DCTLUI_SLIDER_FLOAT, 1.0, 0.0, 2.0, 0.01)
DEFINE_UI_PARAMS(p_PrintBleach, Print Bleach Bypass, DCTLUI_SLIDER_FLOAT, 0.0, 0.0, 1.0, 0.01)
DEFINE_UI_PARAMS(p_Flare, Projection Flare, DCTLUI_SLIDER_FLOAT, 0.0, 0.0, 2.0, 0.01)

DEFINE_UI_PARAMS(p_Strength, Strength, DCTLUI_SLIDER_FLOAT, 1.0, 0.0, 1.0, 0.01)
DEFINE_UI_PARAMS(p_HdrPeak, HDR Peak Luminance, DCTLUI_SLIDER_FLOAT, 1000.0, 100.0, 4000.0, 10.0)
DEFINE_UI_PARAMS(p_HdrGrey, HDR Grey nits, DCTLUI_SLIDER_FLOAT, 18.0, 5.0, 40.0, 0.5)
DEFINE_UI_PARAMS(p_Animate, Animate Grain, DCTLUI_CHECK_BOX, 1)
DEFINE_UI_PARAMS(p_ShowCurve, Show Curve, DCTLUI_CHECK_BOX, 0)

#define GREY      0.18f
#define SDR_GREY  0.115f        // 18% grey on an SDR display (linear): the 2383 LAD grey, visual density 1.0
#define PT        0.02508583f   // one printer point: 1/12 stop of print exposure, log10
#define GOLDEN    2.39996322973f

