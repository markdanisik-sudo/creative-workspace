// =============================================================================
//  FILM LAB COLOR  |  Kodak / Eastman negative + print emulation for DaVinci Resolve
//  v3.0 (spectral)
//
//  Pipeline (per pixel):
//    camera log -> scene linear (Rec.2020 primaries)
//    -> primaries: white balance (CAT02), exposure, contrast, highlights,
//       shadows, saturation, skin
//    -> negative: layer exposure from the stock's spectral sensitivity,
//       Status M characteristic curves, push/pull, bleach bypass
//    -> print: light of the printer lamp through the negative's dyes, seen by
//       the 2383 layers (spectral), timed so 18% grey hits the laboratory aim
//       density; 2383 characteristic curves; projection through the print dyes
//       with a xenon lamp -> CIE 1931 -> Rec.2020
//    -> output encoding (Rec.709, sRGB, P3-D65, Rec.2100 PQ / HLG, DWG/DI, Cineon)
//
//  Grain, halation, bloom and MTF live in FilmLab_Texture.dctl (next node).
//
//  Vision3 50D, 250D, 500T and 2383 use spectral sensitivities, characteristic
//  curves and dye densities digitised from Kodak's published data sheets.  The
//  other stocks use the Vision3 spectral data with their own tone character.
//
//  Requires DaVinci Resolve Studio.
// =============================================================================

DEFINE_UI_PARAMS(p_InGamut, Input Color Space, DCTLUI_COMBO_BOX, 0, { G_DWG, G_AWG3, G_AWG4, G_SG3C, G_VG, G_RWG, G_CCG, G_709, G_2020 }, { "DaVinci Wide Gamut", "ARRI Wide Gamut 3", "ARRI Wide Gamut 4", "Sony S-Gamut3.Cine", "Panasonic V-Gamut", "RED Wide Gamut RGB", "Canon Cinema Gamut", "Rec.709", "Rec.2020" })
DEFINE_UI_PARAMS(p_InGamma, Input Gamma, DCTLUI_COMBO_BOX, 0, { T_DI, T_LOGC3, T_LOGC4, T_SLOG3, T_VLOG, T_LOG3G10, T_CLOG2, T_CLOG3, T_G24, T_LIN, T_CINEON }, { "DaVinci Intermediate", "ARRI LogC3", "ARRI LogC4", "Sony S-Log3", "Panasonic V-Log", "RED Log3G10", "Canon Log 2", "Canon Log 3", "Gamma 2.4", "Linear", "Cineon Log (film scan)" })
DEFINE_UI_PARAMS(p_Stock, Negative Stock, DCTLUI_COMBO_BOX, 1, { V3_5203, V3_5207, V3_5213, V3_5219, V3_5219NR, V2_5201, V2_5205, V2_5212, V2_5217, V2_5218, V2_5229, V1_5246, V1_5274, V1_5277, V1_5279, V1_5289, E_5247, E_5294, EXR_5245, EXR_5248, EXR_5293, EXR_5296, EXR_5298, NEG_NONE }, { "Vision3 50D 5203", "Vision3 250D 5207", "Vision3 200T 5213", "Vision3 500T 5219", "Vision3 500T 5219 no rem-jet", "Vision2 50D 5201", "Vision2 250D 5205", "Vision2 100T 5212", "Vision2 200T 5217", "Vision2 500T 5218", "Vision2 Expression 500T 5229", "Vision 250D 5246", "Vision 200T 5274", "Vision 320T 5277", "Vision 500T 5279", "Vision 800T 5289", "Eastman ECN II 100T 5247", "Eastman 400T 5294", "Eastman EXR 50D 5245", "Eastman EXR 100T 5248", "Eastman EXR 200T 5293", "Eastman EXR 500T 5296", "Eastman EXR 500T 5298", "None - print only" })
DEFINE_UI_PARAMS(p_DRT, DRT, DCTLUI_COMBO_BOX, 0, { DRT_FILM, DRT_NEUTRAL, DRT_OFF, DRT_CINEON }, { "Film Print", "Neutral", "Off - DWG / Intermediate", "Off - Cineon Log (for Resolve 2383 LUT)" })
DEFINE_UI_PARAMS(p_Print, Print Stock, DCTLUI_COMBO_BOX, 0, { PR_2383, PR_2383D60, PR_2383D55, PR_2393 }, { "Kodak 2383 D65", "Kodak 2383 D60", "Kodak 2383 D55", "Kodak 2393" })
DEFINE_UI_PARAMS(p_NegVersion, Negative Version, DCTLUI_COMBO_BOX, 0, { NV_NEW, NV_OLD }, { "New - calibrated on a real 250D scan", "Old - Kodak data sheets only" })
DEFINE_UI_PARAMS(p_PrintVersion, Print Version, DCTLUI_COMBO_BOX, 0, { PV_NEW, PV_OLD }, { "New - calibrated on a real 2383 print", "Old - Kodak data sheets only" })
DEFINE_UI_PARAMS(p_Output, Output, DCTLUI_COMBO_BOX, 0, { OUT_709, OUT_SRGB, OUT_P3, OUT_PQ, OUT_HLG }, { "Rec.709 Gamma 2.4", "sRGB / Rec.709 Gamma 2.2", "P3-D65 Gamma 2.6", "Rec.2100 PQ (HDR)", "Rec.2100 HLG (HDR)" })
DEFINE_UI_PARAMS(p_Strength, Strength, DCTLUI_SLIDER_FLOAT, 1.0, 0.0, 1.0, 0.01)
