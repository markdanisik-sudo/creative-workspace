    } else if (id == V1_5279) {
        // Vision3 spectral data, tone from the stock character
        s.dmin = make_float3(0.173916f, 0.575303f, 0.845082f); s.g = make_float3(0.510868f, 0.596433f, 0.547918f); s.xt = make_float3(-1.12f, -1.12f, -1.12f);
        s.kt = make_float3(0.25f, 0.25f, 0.25f); s.emax = make_float3(2.8f, 2.8f, 2.8f); s.ks = make_float3(0.26f, 0.26f, 0.26f);
        s.mat = 2; s.cd = 0.992f;
    } else if (id == V1_5289) {  // 800T: push-stock look, heavy grain
        // Vision3 spectral data, tone from the stock character
        s.dmin = make_float3(0.173916f, 0.575303f, 0.845082f); s.g = make_float3(0.502759f, 0.586965f, 0.529654f); s.xt = make_float3(-1.1f, -1.1f, -1.1f);
        s.kt = make_float3(0.28f, 0.28f, 0.28f); s.emax = make_float3(2.7f, 2.7f, 2.7f); s.ks = make_float3(0.26f, 0.26f, 0.26f);
        s.mat = 2; s.cd = 0.96f;
    } else if (id == E_5247) {  // ECN II 100T (70s-80s): short scale, punchy warm colour
        // Vision3 spectral data, tone from the stock character
        s.dmin = make_float3(0.173916f, 0.575303f, 0.845082f); s.g = make_float3(0.535195f, 0.615367f, 0.566182f); s.xt = make_float3(-1.02f, -1.02f, -1.02f);
        s.kt = make_float3(0.2f, 0.2f, 0.2f); s.emax = make_float3(2.4f, 2.4f, 2.4f); s.ks = make_float3(0.24f, 0.24f, 0.24f);
        s.mat = 2; s.cd = 1.072f;
    } else if (id == E_5294) {  // 400T (80s): fast, grainy, softer colour
        // Vision3 spectral data, tone from the stock character
        s.dmin = make_float3(0.173916f, 0.575303f, 0.845082f); s.g = make_float3(0.518977f, 0.596433f, 0.538786f); s.xt = make_float3(-1.05f, -1.05f, -1.05f);
        s.kt = make_float3(0.24f, 0.24f, 0.24f); s.emax = make_float3(2.4f, 2.4f, 2.4f); s.ks = make_float3(0.24f, 0.24f, 0.24f);
        s.mat = 2; s.cd = 0.992f;
    } else if (id == EXR_5245) {  // EXR (late 80s-90s): finer grain, still shorter scale than Vision
        // Vision3 spectral data, tone from the stock character
        s.dmin = make_float3(0.173916f, 0.575303f, 0.845082f); s.g = make_float3(0.527086f, 0.6059f, 0.575314f); s.xt = make_float3(-1.06f, -1.06f, -1.06f);
        s.kt = make_float3(0.2f, 0.2f, 0.2f); s.emax = make_float3(2.6f, 2.6f, 2.6f); s.ks = make_float3(0.25f, 0.25f, 0.25f);
        s.mat = 0; s.cd = 1.048f;
    } else if (id == EXR_5248) {
        // Vision3 spectral data, tone from the stock character
        s.dmin = make_float3(0.173916f, 0.575303f, 0.845082f); s.g = make_float3(0.527086f, 0.6059f, 0.566182f); s.xt = make_float3(-1.06f, -1.06f, -1.06f);
        s.kt = make_float3(0.21f, 0.21f, 0.21f); s.emax = make_float3(2.6f, 2.6f, 2.6f); s.ks = make_float3(0.25f, 0.25f, 0.25f);
        s.mat = 2; s.cd = 1.04f;
    } else if (id == EXR_5293) {
        // Vision3 spectral data, tone from the stock character
        s.dmin = make_float3(0.173916f, 0.575303f, 0.845082f); s.g = make_float3(0.527086f, 0.615367f, 0.566182f); s.xt = make_float3(-1.07f, -1.07f, -1.07f);
        s.kt = make_float3(0.21f, 0.21f, 0.21f); s.emax = make_float3(2.6f, 2.6f, 2.6f); s.ks = make_float3(0.25f, 0.25f, 0.25f);
        s.mat = 2; s.cd = 1.032f;
    } else if (id == EXR_5296) {  // 500T: the late-80s / 90s night stock
        // Vision3 spectral data, tone from the stock character
        s.dmin = make_float3(0.173916f, 0.575303f, 0.845082f); s.g = make_float3(0.518977f, 0.596433f, 0.538786f); s.xt = make_float3(-1.1f, -1.1f, -1.1f);
        s.kt = make_float3(0.25f, 0.25f, 0.25f); s.emax = make_float3(2.5f, 2.5f, 2.5f); s.ks = make_float3(0.25f, 0.25f, 0.25f);
        s.mat = 2; s.cd = 1.0f;
    } else if (id == EXR_5298) {  // 500T: higher contrast, punchier than 5296
        // Vision3 spectral data, tone from the stock character
        s.dmin = make_float3(0.173916f, 0.575303f, 0.845082f); s.g = make_float3(0.543304f, 0.624834f, 0.575314f); s.xt = make_float3(-1.06f, -1.06f, -1.06f);
        s.kt = make_float3(0.23f, 0.23f, 0.23f); s.emax = make_float3(2.5f, 2.5f, 2.5f); s.ks = make_float3(0.25f, 0.25f, 0.25f);
        s.mat = 2; s.cd = 1.032f;
    } else {                      // NEG_NONE: ideal negative, straight line, no colour of its own
        s.dmin = make_float3(0.173916f, 0.575303f, 0.845082f); s.g = make_float3(0.6f, 0.6f, 0.6f); s.xt = make_float3(-1.45f, -1.45f, -1.45f);
        s.kt = make_float3(0.05f, 0.05f, 0.05f); s.emax = make_float3(9.0f, 9.0f, 9.0f); s.ks = make_float3(0.3f, 0.3f, 0.3f);
        s.mat = 3; s.cd = 1.0f;
    }
    return s;
}
// Exposure-equivalent density: straight line through `xt` with soft toe and
// soft shoulder at `emax`.  Multiply by gamma to get density above base.
__DEVICE__ float hd_curve(float x, float xt, float kt, float emax, float ks)
{
    float e = kt * softplus10((x - xt) / kt);
    return e - ks * softplus10((e - emax) / ks);
}

// push / pull processing: development time changes contrast and shadow speed;
// a neutral curve gives all three layers the same shape (no crossover)
__DEVICE__ NegStock develop(NegStock s, float pp, int neutral)
{
    float g = 1.0f + 0.12f * pp;
    s.g = scale3(s.g, g);
    s.xt = add3(s.xt, make_float3(0.07f * pp, 0.07f * pp, 0.07f * pp));
    if (neutral) {
        float m;
        m = (s.g.x + s.g.y + s.g.z) * (1.0f / 3.0f); s.g = make_float3(m, m, m);
        m = (s.xt.x + s.xt.y + s.xt.z) * (1.0f / 3.0f); s.xt = make_float3(m, m, m);
        m = (s.kt.x + s.kt.y + s.kt.z) * (1.0f / 3.0f); s.kt = make_float3(m, m, m);
        m = (s.emax.x + s.emax.y + s.emax.z) * (1.0f / 3.0f); s.emax = make_float3(m, m, m);
        m = (s.ks.x + s.ks.y + s.ks.z) * (1.0f / 3.0f); s.ks = make_float3(m, m, m);
    }
    return s;
}

// scene light -> negative Status M densities.  Color Density scales the
// separation between the layer exposures (1 = stock, 0 = monochrome).
__DEVICE__ float3 neg_density(float3 E, NegStock s, float cd, float ii)
{
    float3 e = layer_exposure(E, s.mat);
    float xr = _log10f(_fmaxf(e.x, 1e-7f) / GREY);
    float xg = _log10f(_fmaxf(e.y, 1e-7f) / GREY);
    float xb = _log10f(_fmaxf(e.z, 1e-7f) / GREY);
    if (ii != 0.0f && s.mat != 3) {
        float r = xr, g = xg, b = xb;
        xr = r + ii * (II_RG * (r - g) + II_RB * (r - b));
        xg = g + ii * (II_GR * (g - r) + II_GB * (g - b));
        xb = b + ii * (II_BR * (b - r) + II_BG * (b - g));
    }
    float k = cd * s.cd;
    float xm = 0.2627f * xr + 0.6780f * xg + 0.0593f * xb;
    xr = xm + k * (xr - xm); xg = xm + k * (xg - xm); xb = xm + k * (xb - xm);
    return make_float3(s.dmin.x + s.g.x * hd_curve(xr, s.xt.x, s.kt.x, s.emax.x, s.ks.x),
                       s.dmin.y + s.g.y * hd_curve(xg, s.xt.y, s.kt.y, s.emax.y, s.ks.y),
                       s.dmin.z + s.g.z * hd_curve(xb, s.xt.z, s.kt.z, s.emax.z, s.ks.z));
}

typedef struct {
    float3 D;        // Status M density of the pixel
    float3 Dg;       // ... and of the 18% grey (for printer timing and scans)
    float silver;    // retained silver (bleach bypass), neutral density
    float silverG;   // ... in the 18% grey
    float3 g;        // layer gammas (for scans)
    int mat;
} NegOut;

// the stock blended with an ideal, colour-neutral negative (Negative Strength)
__DEVICE__ NegOut negative(float3 E, NegStock s, float cd, float ii, float strength, int bleach)
{
    NegStock id = neg_stock(NEG_NONE);
    float3 grey = make_float3(GREY, GREY, GREY);
    NegOut n;
    float3 Di = neg_density(E, id, 1.0f, 0.0f), Dgi = neg_density(grey, id, 1.0f, 0.0f);
    float3 Ds = neg_density(E, s, cd, ii), Dgs = neg_density(grey, s, cd, ii);
    n.D = add3(Di, scale3(add3(Ds, scale3(Di, -1.0f)), strength));
    n.Dg = add3(Dgi, scale3(add3(Dgs, scale3(Dgi, -1.0f)), strength));
    n.g = add3(id.g, scale3(add3(s.g, scale3(id.g, -1.0f)), strength));
    n.mat = strength > 0.5f ? s.mat : id.mat;
    n.silver = 0.0f; n.silverG = 0.0f;
    if (bleach) {
        float3 a = add3(n.D, scale3(s.dmin, -1.0f)), b = add3(n.Dg, scale3(s.dmin, -1.0f));
        n.silver = 0.5f * _fmaxf(a.x + a.y + a.z, 0.0f) * (1.0f / 3.0f);
        n.silverG = 0.5f * _fmaxf(b.x + b.y + b.z, 0.0f) * (1.0f / 3.0f);
    }
    return n;
}

// negative -> scene light along each layer's straight line (a "scan"); the
// toe, shoulder and crossover of the stock stay baked in
__DEVICE__ float3 negative_to_scene(NegOut n)
{
    float3 e = make_float3(GREY * exp10_f((n.D.x - n.Dg.x) / n.g.x),
                           GREY * exp10_f((n.D.y - n.Dg.y) / n.g.y),
                           GREY * exp10_f((n.D.z - n.Dg.z) / n.g.z));
    return layer_to_scene(e, n.mat);
}

// Cineon printing density: 0.002 D per code value, 18% grey on 445
__DEVICE__ float3 negative_to_cineon(NegOut n)
{
    return make_float3((445.0f + (n.D.x - n.Dg.x) / 0.002f) / 1023.0f,
                       (445.0f + (n.D.y - n.Dg.y) / 0.002f) / 1023.0f,
                       (445.0f + (n.D.z - n.Dg.z) / 0.002f) / 1023.0f);
}

// -----------------------------------------------------------------------------
//  Print (2383): spectral printing, Status A characteristic curves, projection
// -----------------------------------------------------------------------------

// print cross-talk, fitted on a ColorChecker in a real 2383 print (Print Version = New)
#define PI_RG -0.1236f
#define PI_RB -0.0665f
#define PI_GR  0.0655f
#define PI_GB  0.0870f
#define PI_BR -0.0223f
#define PI_BG -0.0381f

typedef struct {
    int print, calib;
    float printExp, printR, printG, printB, contrast;
    float dyeSat, dyeC, dyeM, dyeY;
    float blackToe, shadowRoll, highlightRoll, bleach;
    int neutral;
    float flare, flareHue, flareTint;
} PrintCtl;

__DEVICE__ float3 add_flare(float3 L, float flare, float hue, float tint)
{
    if (flare <= 0.0f) return L;
    float h = hue / 360.0f;
    float3 hc = make_float3(clampf(_fabs(h * 6.0f - 3.0f) - 1.0f, 0.0f, 1.0f),
                            clampf(2.0f - _fabs(h * 6.0f - 2.0f), 0.0f, 1.0f),
                            clampf(2.0f - _fabs(h * 6.0f - 4.0f), 0.0f, 1.0f));
    hc = scale3(hc, 1.0f / _fmaxf(luma2020(hc), 1e-3f));
    float fl = flare * 0.002f;
    float fr = fl * (1.0f + tint * (hc.x - 1.0f));
    float fg = fl * (1.0f + tint * (hc.y - 1.0f));
    float fb = fl * (1.0f + tint * (hc.z - 1.0f));
    return make_float3((L.x + fr) / (1.0f + fr), (L.y + fg) / (1.0f + fg), (L.z + fb) / (1.0f + fb));
}

// light from the printer lamp through the negative, as seen by the three
// 2383 layers (spectral integration over the negative's dye densities)
__DEVICE__ float3 print_exposure(float3 D, float silver)
{
    float3 a = mat3x3(add3(D, scale3(make_float3(NEG_DMIN_M), -1.0f)), AINV_NEG);
    float hr = 0.0f, hg = 0.0f, hb = 0.0f;
    for (int i = 0; i < NWL; i++) {
        float dens = a.x * NEG_DYE_C[i] + a.y * NEG_DYE_M[i] + a.z * NEG_DYE_Y[i] + silver;
        float t = _exp2f(-3.32192809f * dens);
        hr += PRINT_W_R[i] * t; hg += PRINT_W_G[i] * t; hb += PRINT_W_B[i] * t;
    }
    return make_float3(_fmaxf(hr, 1e-12f), _fmaxf(hg, 1e-12f), _fmaxf(hb, 1e-12f));
}

typedef struct { float dmin, dmax, x0, g, s, hl, sh; } PCurve;

// 2383 characteristic curve (Status A density vs log exposure): a generalised
// logistic; the roll-off controls stretch the highlight (t < 0) and shadow
// (t > 0) side, which keeps the curve continuous and monotonic
__DEVICE__ float pcurve(float x, PCurve c)
{
    float t = (x - c.x0) * c.g;
    t = t < 0.0f ? t / c.hl : t / c.sh;
    return c.dmin + (c.dmax - c.dmin) / _powf(1.0f + _expf(-t / c.s), c.s);
}

__DEVICE__ float pcurve_inv(float D, PCurve c)
{
    D = clampf(D, c.dmin + 1e-4f, c.dmax - 1e-4f);
    float r = (c.dmax - c.dmin) / (D - c.dmin);
    float t = -c.s * _logf(_powf(r, 1.0f / c.s) - 1.0f);
    t = t < 0.0f ? t * c.hl : t * c.sh;
    return c.x0 + t / c.g;
}

__DEVICE__ PCurve make_pcurve(float dmin, float dmax, float x0, float g, float a, float b, PrintCtl c, float3 avg)
{
    PCurve p;
    p.dmin = dmin; p.dmax = dmax; p.x0 = x0; p.g = g; p.s = 0.5f * (a + b);
    if (c.neutral) { p.g = avg.x; p.s = 0.5f * (avg.y + avg.z); }
    if (c.print == PR_2393) { p.g *= 1.08f; p.dmax += 0.45f; }          // Vision Premier: more contrast, denser blacks
    p.g *= c.contrast;
    p.hl = _fmaxf(1.0f + 0.6f * c.highlightRoll, 0.3f);                  // highlight roll-off: longer / shorter toe
    p.sh = _fmaxf(1.0f + 0.8f * c.shadowRoll, 0.3f);                     // shadow roll-off: softer / harder shoulder
    p.dmax = _fmaxf(p.dmax - 1.2f * c.blackToe, 1.8f);                   // black toe: how deep the blacks go
    return p;
}

// negative -> projected print light (linear Rec.2020, clear print = 1)
__DEVICE__ float3 film_print(NegOut n, PrintCtl c)
{
    float3 avg = make_float3(PRINT_CURVE_AVG);
    PCurve pr = make_pcurve(PRINT_CURVE_R, c, avg);
    PCurve pg = make_pcurve(PRINT_CURVE_G, c, avg);
    PCurve pb = make_pcurve(PRINT_CURVE_B, c, avg);

    // printer timing: the 18% grey prints to the laboratory aim density;
    // printer lights are offsets from there (+ = brighter / more of that colour)
    float3 H = print_exposure(n.D, n.silver);
    float3 Hg = print_exposure(n.Dg, n.silverG);
    float er = _log10f(H.x / Hg.x), eg = _log10f(H.y / Hg.y), eb = _log10f(H.z / Hg.z);
    if (c.calib) {
        // fitted on a real 2383 print: layer cross-talk the data sheets don't show
        float r = er, g = eg, b = eb;
        er = r + PI_RG * (r - g) + PI_RB * (r - b);
        eg = g + PI_GR * (g - r) + PI_GB * (g - b);
        eb = b + PI_BR * (b - r) + PI_BG * (b - g);
    }
    float ur = er + pcurve_inv(LAD_R, pr) + PT * (c.printExp + c.printR);
    float ug = eg + pcurve_inv(LAD_G, pg) + PT * (c.printExp + c.printG);
    float ub = eb + pcurve_inv(LAD_B, pb) + PT * (c.printExp + c.printB);
    float Dr = pcurve(ur, pr), Dg = pcurve(ug, pg), Db = pcurve(ub, pb);

    // dye saturation: each layer's departure from a visual neutral of the same
    // density (cyan = red channel, magenta = green, yellow = blue)
    float Dn = (Dr + Dg + Db) * (1.0f / 3.0f);
    float on = (LAD_R + LAD_G + LAD_B) * (1.0f / 3.0f);
    Dr = Dn + (LAD_R - on) + (Dr - Dn - (LAD_R - on)) * c.dyeSat * c.dyeC;
    Dg = Dn + (LAD_G - on) + (Dg - Dn - (LAD_G - on)) * c.dyeSat * c.dyeM;
    Db = Dn + (LAD_B - on) + (Db - Dn - (LAD_B - on)) * c.dyeSat * c.dyeY;

    // dye amounts above the print base, then projection through the dyes
    float3 a = mat3x3(add3(make_float3(Dr, Dg, Db), scale3(make_float3(PRINT_DMIN_A), -1.0f)), AINV_PRINT);
    float silver = c.bleach > 0.0f ? 0.6f * c.bleach * _fmaxf(Dn - 0.06f, 0.0f) : 0.0f;
    float3 L = make_float3(0.0f, 0.0f, 0.0f);
    for (int i = 0; i < NWL; i++) {
        float dens = a.x * PRINT_DYE_C[i] + a.y * PRINT_DYE_M[i] + a.z * PRINT_DYE_Y[i] + silver;
        float t = _exp2f(-3.32192809f * dens);
        L.x += PROJ_R[i] * t; L.y += PROJ_G[i] * t; L.z += PROJ_B[i] * t;
    }

    // D60 / D55: same print, warmer projection white (gains in display light)
    if (c.print == PR_2383D60) L = make_float3(L.x, L.y * 0.951f, L.z * 0.875f);
    else if (c.print == PR_2383D55) L = make_float3(L.x, L.y * 0.895f, L.z * 0.746f);
    return add_flare(L, c.flare, c.flareHue, c.flareTint);
}

// -----------------------------------------------------------------------------
//  Display rendering
// -----------------------------------------------------------------------------

// neutral DRT: hue-preserving tonescale on max(RGB), mid grey -> SDR grey,
// highlights roll off and desaturate towards white
__DEVICE__ float3 neutral_drt(float3 c)
{
    c = make_float3(_fmaxf(c.x, 0.0f), _fmaxf(c.y, 0.0f), _fmaxf(c.z, 0.0f));
    float n = _fmaxf(_fmaxf(c.x, c.y), c.z);
    if (n < 1e-7f) return make_float3(0.0f, 0.0f, 0.0f);
    float p = _powf(n, 1.2f);
    float t = 1.05f * p / (p + 1.039f);            // puts 0.18 at SDR_GREY, like the print
    c = scale3(c, t / n);
    float Y = luma2020(c);
    float k = 0.6f * smooth01(0.6f, 1.05f, t);
    return make_float3(Y + (c.x - Y) * (1.0f - k), Y + (c.y - Y) * (1.0f - k), Y + (c.z - Y) * (1.0f - k));
}

// SDR-relative light -> nits: below grey a plain scale, above it the range
// opens up so that SDR white lands on the HDR peak
__DEVICE__ float3 hdr_expand(float3 L, float peak, float grey)
{
    float Y = luma2020(L);
    if (Y <= 1e-7f) return scale3(L, grey / SDR_GREY);
    float y = _logf(Y / SDR_GREY);
    float yw = _logf(1.0f / SDR_GREY);
    float a = 8.0f;
    float k1 = (_logf(peak / grey) - yw) * a / (softplus_e(a * yw) - 0.69314718f);
    float f = y + k1 * (softplus_e(a * y) - 0.69314718f) / a;   // f(0) = 0: grey stays on `grey`
    return scale3(L, grey * _expf(f) / Y);
}

__DEVICE__ float pq_encode(float nits)
{
    float y = _powf(clampf(nits / 10000.0f, 0.0f, 1.0f), 0.1593017578125f);
    return _powf((0.8359375f + 18.8515625f * y) / (1.0f + 18.6875f * y), 78.84375f);
}

__DEVICE__ float hlg_oetf(float e)
{
    if (e <= 1.0f / 12.0f) return _sqrtf(3.0f * _fmaxf(e, 0.0f));
    return 0.17883277f * _logf(12.0f * e - 0.28466892f) + 0.55991073f;
}

// pull negative components toward luminance (keeps hue, avoids clipping skew)
__DEVICE__ float3 gamut_compress(float3 o, float Y)
{
    float mn = _fminf(o.x, _fminf(o.y, o.z));
    if (mn < 0.0f && Y > 0.0f) {
        float t = Y / (Y - mn);
        o = make_float3(Y + (o.x - Y) * t, Y + (o.y - Y) * t, Y + (o.z - Y) * t);
    }
    return o;
}

// display light (linear Rec.2020, SDR white = 1) -> output code values
__DEVICE__ float3 encode_output(float3 L, int outSel, float peak, float grey)
{
    float Y = luma2020(L);
    if (outSel == OUT_PQ || outSel == OUT_HLG) {
        float3 n = hdr_expand(gamut_compress(L, Y), peak, grey);
        n = make_float3(_fmaxf(n.x, 0.0f), _fmaxf(n.y, 0.0f), _fmaxf(n.z, 0.0f));
        if (outSel == OUT_PQ) return make_float3(pq_encode(n.x), pq_encode(n.y), pq_encode(n.z));
        // HLG: undo the reference OOTF for this peak, then the OETF
        float g = 1.2f + 0.42f * _log10f(peak / 1000.0f);
        float3 d = scale3(n, 1.0f / peak);
        float Yd = _fmaxf(luma2020(d), 1e-7f);
        float3 sc = scale3(d, _powf(Yd, 1.0f / g - 1.0f));
        return make_float3(hlg_oetf(sc.x), hlg_oetf(sc.y), hlg_oetf(sc.z));
    }
    float3 o;
    if (outSel == OUT_P3) o = mul3(L, 1.34357825f, -0.28217967f, -0.06139858f, -0.06529745f, 1.07578792f, -0.01049046f, 0.00282179f, -0.01959849f, 1.01677671f);
    else o = mul3(L, 1.66049100f, -0.58764114f, -0.07284986f, -0.12455047f, 1.13289990f, -0.00834942f, -0.01815076f, -0.10057890f, 1.11872966f);
    o = gamut_compress(o, Y);
    o = make_float3(clampf(o.x, 0.0f, 1.0f), clampf(o.y, 0.0f, 1.0f), clampf(o.z, 0.0f, 1.0f));
    float gm = 1.0f / 2.4f;
    if (outSel == OUT_SRGB) gm = 1.0f / 2.2f;
    else if (outSel == OUT_P3) gm = 1.0f / 2.6f;
    return make_float3(_powf(o.x, gm), _powf(o.y, gm), _powf(o.z, gm));
}

// the whole node after the primaries; `film` = 0 renders the neutral
// reference used by Strength (ideal negative, neutral DRT)
__DEVICE__ float3 render(float3 E, int film, int drt, int outSel, NegStock ns, float cd, float ii, int negBleach,
                         float negStr, float printStr, PrintCtl pc, float peak, float grey)
{
    NegOut n = negative(E, ns, cd, ii, film ? negStr : 0.0f, film ? negBleach : 0);
    if (drt == DRT_CINEON) return negative_to_cineon(n);

    float3 scene = (film && n.mat != 3) ? negative_to_scene(n) : E;     // the ideal negative scans back exactly
    if (drt == DRT_OFF) return lin2020_to_di(scene);

    float3 neutralOut = encode_output(neutral_drt(scene), outSel, peak, grey);
    if (drt != DRT_FILM || !film) return neutralOut;
    float3 printOut = encode_output(film_print(n, pc), outSel, peak, grey);
    return add3(scale3(neutralOut, 1.0f - printStr), scale3(printOut, printStr));
}

// -----------------------------------------------------------------------------
//  Main
// -----------------------------------------------------------------------------

__DEVICE__ float3 transform(int p_Width, int p_Height, int p_X, int p_Y, float p_R, float p_G, float p_B)
{
    NegStock ns = develop(neg_stock(p_Stock), p_PushPull, p_NeutralNeg);

    PrintCtl pc;
    pc.print = p_Print; pc.calib = p_PrintVersion == PV_NEW;
    pc.printExp = p_PrintExp; pc.printR = p_PrintR; pc.printG = p_PrintG; pc.printB = p_PrintB;
    pc.contrast = p_PrintContrast;
    pc.dyeSat = p_DyeSat; pc.dyeC = p_DyeC; pc.dyeM = p_DyeM; pc.dyeY = p_DyeY;
    pc.blackToe = p_BlackToe; pc.shadowRoll = p_ShadowRoll; pc.highlightRoll = p_HighlightRoll;
    pc.bleach = p_PrintBleach; pc.neutral = p_NeutralPrint;
    pc.flare = p_Flare; pc.flareHue = p_FlareHue; pc.flareTint = p_FlareTint;

    // ---- Show Curve: a neutral grey ramp through the whole node, drawn bottom left
    int inBox = 0;
    float fx = 0.0f, fy = 0.0f, bw = 1.0f, bh = 1.0f;
    if (p_ShowCurve) {
        bw = 0.32f * (float)p_Width;
        bh = 0.30f * (float)p_Height;
        float bx = 0.03f * (float)p_Width;
        float by = (float)p_Height - 0.04f * (float)p_Height - bh;
        fx = ((float)p_X - bx) / bw;
        fy = 1.0f - ((float)p_Y - by) / bh;
        if (fx >= 0.0f && fx <= 1.0f && fy >= 0.0f && fy <= 1.0f) inBox = 1;
    }

    float3 E;
    if (inBox) {
        float g = GREY * _exp2f(-8.0f + 16.0f * fx);               // scene stops around grey
        E = make_float3(g, g, g);
    } else {
        E = gamut_to_2020(make_float3(decode_gamma(p_R, p_InGamma), decode_gamma(p_G, p_InGamma), decode_gamma(p_B, p_InGamma)), p_InGamut);
    }
    E = primaries(E, p_Exposure, p_Contrast, p_Pivot, p_Highlights, p_Shadows,
                  p_Temp, p_Tint, p_Saturation, p_SkinHue, p_SkinSat);

    float3 res = render(E, 1, p_DRT, p_Output, ns, p_ColorDensity, (p_NegVersion == NV_OLD ? 0.0f : p_Interimage), p_NegBleach, p_NegStrength, p_PrintStrength, pc, p_HdrPeak, p_HdrGrey);
    if (p_Strength < 1.0f) {
        float3 ref = render(E, 0, p_DRT, p_Output, ns, p_ColorDensity, (p_NegVersion == NV_OLD ? 0.0f : p_Interimage), p_NegBleach, p_NegStrength, p_PrintStrength, pc, p_HdrPeak, p_HdrGrey);
        res = add3(scale3(ref, 1.0f - p_Strength), scale3(res, p_Strength));
    }

    if (inBox) {
        float stops = -8.0f + 16.0f * fx;
        float3 dot = make_float3(0.08f, 0.08f, 0.08f);
        float gx = _fabs(stops - 2.0f * _floorf(stops * 0.5f + 0.5f)) * bw / 16.0f;
        float gy = _fabs(fy * 4.0f - _floorf(fy * 4.0f + 0.5f)) * bh / 4.0f;
        if (gx < 0.6f || gy < 0.6f) dot = make_float3(0.18f, 0.18f, 0.18f);
        if (_fabs(stops) * bw / 16.0f < 0.8f) dot = make_float3(0.32f, 0.32f, 0.32f);
        float w = 1.6f / bh;
        if (_fabs(res.z - fy) < w) dot = make_float3(0.25f, 0.45f, 1.0f);
        if (_fabs(res.y - fy) < w) dot = make_float3(0.2f, 0.9f, 0.3f);
        if (_fabs(res.x - fy) < w) dot = make_float3(1.0f, 0.25f, 0.2f);
        res = dot;
    }
    return make_float3(res.x, res.y, res.z);
}
