// -----------------------------------------------------------------------------
//  Helpers
// -----------------------------------------------------------------------------

__DEVICE__ float clampf(float x, float a, float b) { return _fminf(_fmaxf(x, a), b); }
__DEVICE__ int clampi(int x, int a, int b) { return x < a ? a : (x > b ? b : x); }
__DEVICE__ float exp10_f(float x) { return _exp2f(3.32192809f * x); }
__DEVICE__ float3 add3(float3 a, float3 b) { return make_float3(a.x + b.x, a.y + b.y, a.z + b.z); }
__DEVICE__ float3 sub3(float3 a, float3 b) { return make_float3(a.x - b.x, a.y - b.y, a.z - b.z); }
__DEVICE__ float3 scale3(float3 a, float s) { return make_float3(a.x * s, a.y * s, a.z * s); }
__DEVICE__ float3 mix3(float3 a, float3 b, float t) { return make_float3(a.x + (b.x - a.x) * t, a.y + (b.y - a.y) * t, a.z + (b.z - a.z) * t); }
__DEVICE__ float luma2020(float3 c) { return 0.2627f * c.x + 0.6780f * c.y + 0.0593f * c.z; }

__DEVICE__ float smooth01(float a, float b, float x)
{
    float t = clampf((x - a) / (b - a), 0.0f, 1.0f);
    return t * t * (3.0f - 2.0f * t);
}

// log10(1 + 10^z) and ln(1 + e^z) without overflow
__DEVICE__ float softplus10(float z)
{
    if (z > 0.0f) return z + _log10f(1.0f + exp10_f(-z));
    return _log10f(1.0f + exp10_f(z));
}

__DEVICE__ float softplus_e(float z)
{
    if (z > 0.0f) return z + _logf(1.0f + _expf(-z));
    return _logf(1.0f + _expf(z));
}

__DEVICE__ float3 mul3(float3 c, float a, float b, float d, float e, float f, float g, float h, float i, float j)
{
    return make_float3(a * c.x + b * c.y + d * c.z, e * c.x + f * c.y + g * c.z, h * c.x + i * c.y + j * c.z);
}

// x_i += k * sum_j c_ij (x_i - x_j)   (c = RG, RB, GR, GB, BR, BG)
__DEVICE__ float3 couple(float3 x, float k, float rg, float rb, float gr, float gb, float br, float bg)
{
    if (k == 0.0f) return x;
    return make_float3(x.x + k * (rg * (x.x - x.y) + rb * (x.x - x.z)),
                       x.y + k * (gr * (x.y - x.x) + gb * (x.y - x.z)),
                       x.z + k * (br * (x.z - x.x) + bg * (x.z - x.y)));
}

// -----------------------------------------------------------------------------
//  Input: camera code values -> scene linear, Rec.2020 primaries
//
//  Every log formula here takes the 10-bit code value / 1023 (verified against
//  colour-science; Canon Log 2 grey = 0.398).  Input Data Levels = Video
//  first undoes a legal-range-to-0-1 scaling.  v3 applied that conversion in
//  the wrong direction for Canon Log 2 / 3 only.
// -----------------------------------------------------------------------------

__DEVICE__ float di_to_lin(float x)
{
    if (x <= 0.02740668f) return x / 10.44426855f;
    return _exp2f(x / 0.07329248f - 7.0f) - 0.0075f;
}

__DEVICE__ float lin_to_di(float x)
{
    if (x <= 0.00262409f) return x * 10.44426855f;
    return (_log2f(x + 0.0075f) + 7.0f) * 0.07329248f;
}

__DEVICE__ float decode_gamma(float x, int t, int levels)
{
    // log encodings from legal-range video: back to code / 1023
    if (levels == LV_VIDEO && t != T_DI && t != T_G24 && t != T_LIN && t != T_CINEON)
        x = (x * 876.0f + 64.0f) / 1023.0f;
    if (t == T_DI) return di_to_lin(x);
    if (t == T_LOGC3) {                                         // ARRI LogC3, EI 800
        if (x > 0.149658f) return (exp10_f((x - 0.385537f) / 0.247190f) - 0.052272f) / 5.555556f;
        return (x - 0.092809f) / 5.367655f;
    }
    if (t == T_LOGC4) {
        if (x >= 0.0f) return (_exp2f(14.0f * (x - 0.09286413f) / 0.90713587f + 6.0f) - 64.0f) / 2231.82630906f;
        return x * 0.11384993f - 0.01805699f;
    }
    if (t == T_SLOG3) {
        if (x >= 171.2102946929f / 1023.0f) return exp10_f((x * 1023.0f - 420.0f) / 261.5f) * 0.19f - 0.01f;
        return (x * 1023.0f - 95.0f) * 0.01125f / (171.2102946929f - 95.0f);
    }
    if (t == T_VLOG) {
        if (x < 0.181f) return (x - 0.125f) / 5.6f;
        return exp10_f((x - 0.598206f) / 0.241514f) - 0.00873f;
    }
    if (t == T_LOG3G10) {
        if (x < 0.0f) return x / 15.1927f - 0.01f;
        return (exp10_f(x / 0.224282f) - 1.0f) / 155.975327f - 0.01f;
    }
    if (t == T_CLOG2) {                                         // Canon Log 2: reflection = 0.9 x linear
        if (x < 0.092864125f) return -0.9f * (exp10_f((0.092864125f - x) / 0.24136077f) - 1.0f) / 87.09937546f;
        return 0.9f * (exp10_f((x - 0.092864125f) / 0.24136077f) - 1.0f) / 87.09937546f;
    }
    if (t == T_CLOG3) {
        if (x < 0.097465473f) return -0.9f * (exp10_f((0.12783901f - x) / 0.36726845f) - 1.0f) / 14.98325f;
        if (x <= 0.15277891f) return 0.9f * (x - 0.12512219f) / 1.9754798f;
        return 0.9f * (exp10_f((x - 0.12240537f) / 0.36726845f) - 1.0f) / 14.98325f;
    }
    if (t == T_G24) return _powf(_fmaxf(x, 0.0f), 2.4f);
    if (t == T_CINEON) return GREY * exp10_f((x * 1023.0f - 445.0f) * 0.002f / 0.6f);   // grey on 445
    return x;
}

__DEVICE__ float3 gamut_to_2020(float3 c, int g)
{
    if (g == G_DWG)  return mul3(c, 1.13030218f, -0.02039285f, -0.10990933f, -0.02554706f, 1.31084932f, -0.28530226f, -0.09259861f, -0.16465302f, 1.25725163f);
    if (g == G_AWG3) return mul3(c, 0.99068812f, 0.09253966f, -0.08322777f, 0.04663223f, 1.18752685f, -0.23415909f, 0.00140359f, -0.09460200f, 1.09319842f);
    if (g == G_AWG4) return mul3(c, 1.11946906f, -0.05519563f, -0.06427343f, -0.05848446f, 1.17673493f, -0.11825048f, 0.00154745f, -0.03113533f, 1.02958788f);
    if (g == G_SG3C) return mul3(c, 0.96004634f, 0.11953298f, -0.07957932f, -0.05223948f, 1.26430575f, -0.21206627f, -0.02884051f, -0.05952097f, 1.08836147f);
    if (g == G_VG)   return mul3(c, 1.07635314f, -0.01314478f, -0.06320837f, -0.03186184f, 1.15105266f, -0.11919082f, -0.00793202f, -0.03480314f, 1.04273516f);
    if (g == G_RWG)  return mul3(c, 1.18043085f, -0.09403956f, -0.08639129f, -0.02801732f, 1.31144204f, -0.28342472f, -0.07435952f, -0.36207760f, 1.43643712f);
    if (g == G_CCG)  return mul3(c, 1.13873610f, -0.02676853f, -0.11196757f, -0.05520759f, 1.31557329f, -0.26036570f, -0.00765941f, -0.25769762f, 1.26535703f);
    if (g == G_709)  return mul3(c, 0.62740390f, 0.32928304f, 0.04331307f, 0.06909729f, 0.91954040f, 0.01136232f, 0.01639144f, 0.08801331f, 0.89559525f);
    return c;
}

__DEVICE__ float3 camera_to_scene(float3 code, int gamut, int gamma, int levels)
{
    return gamut_to_2020(make_float3(decode_gamma(code.x, gamma, levels), decode_gamma(code.y, gamma, levels),
                                     decode_gamma(code.z, gamma, levels)), gamut);
}

__DEVICE__ float3 scene_to_dwg_di(float3 c)
{
    c = mul3(c, 0.89211212f, 0.02436918f, 0.08351870f, 0.03261660f, 0.78613752f, 0.18124588f, 0.06997705f, 0.10474949f, 0.82527346f);
    return make_float3(lin_to_di(c.x), lin_to_di(c.y), lin_to_di(c.z));
}

// -----------------------------------------------------------------------------
//  White balance (CAT02), before the film: the scene was lit by a T kelvin
//  source (tint off the blackbody locus, + = magenta), adapted to 6500 K
// -----------------------------------------------------------------------------

__DEVICE__ float3 planck_uv(float T)
{
    float u = (0.860117757f + 1.54118254e-4f * T + 1.28641212e-7f * T * T) / (1.0f + 8.42420235e-4f * T + 7.08145163e-7f * T * T);
    float v = (0.317398726f + 4.22806245e-5f * T + 4.20481691e-8f * T * T) / (1.0f - 2.89741816e-5f * T + 1.61456053e-7f * T * T);
    return make_float3(u, v, 0.0f);
}

__DEVICE__ float3 uv_to_lms(float3 uv)
{
    float d = 2.0f * uv.x - 8.0f * uv.y + 4.0f;
    float x = 3.0f * uv.x / d, y = 2.0f * uv.y / d;
    return mul3(make_float3(x / y, 1.0f, (1.0f - x - y) / y), 0.7328f, 0.4296f, -0.1624f, -0.7036f, 1.6975f, 0.0061f, 0.0030f, 0.0136f, 0.9834f);
}

// cone gains of the adaptation (1, 1, 1 = none)
__DEVICE__ float3 wb_gains(float T, float tint)
{
    if (T == 6500.0f && tint == 0.0f) return make_float3(1.0f, 1.0f, 1.0f);
    float3 src = planck_uv(T);
    float3 t0 = planck_uv(T - 50.0f), t1 = planck_uv(T + 50.0f);
    float tu = t1.x - t0.x, tv = t1.y - t0.y, tl = _sqrtf(tu * tu + tv * tv);
    src.x += 0.015f * tint * tv / tl;
    src.y -= 0.015f * tint * tu / tl;
    float3 ls = uv_to_lms(src), lr = uv_to_lms(planck_uv(6500.0f));
    return make_float3(lr.x / ls.x, lr.y / ls.y, lr.z / ls.z);
}

__DEVICE__ float3 white_balance(float3 c, float3 g)
{
    if (g.x == 1.0f && g.y == 1.0f && g.z == 1.0f) return c;
    float3 lms = mul3(c, 0.57961887f, 0.39268423f, -0.02307198f, -0.00223007f, 1.04932052f, -0.01168798f, 0.00548360f, 0.03726131f, 1.04468585f);
    lms = make_float3(lms.x * g.x, lms.y * g.y, lms.z * g.z);
    return mul3(lms, 1.72249578f, -0.64569902f, 0.03081737f, 0.00355862f, 0.95128521f, 0.01072160f, -0.00916837f, -0.03054065f, 0.95668139f);
}

// -----------------------------------------------------------------------------
//  Negative
// -----------------------------------------------------------------------------

typedef struct {
    int sens, dyes;
    float3 dmin, g, xt, kt, emax, ks;     // per layer: density = dmin + g * hd(log E)
    float halation, grain;
} Stock;

__DEVICE__ Stock stock(int id)
{
    int o = clampi(id, 0, NSTOCK - 1) * STOCK_STRIDE;
    Stock s;
    s.sens = (int)(STOCKS[o] + 0.5f);
    s.dyes = (int)(STOCKS[o + 1] + 0.5f);
    s.dmin = make_float3(STOCKS[o + 2], STOCKS[o + 8], STOCKS[o + 14]);
    s.g    = make_float3(STOCKS[o + 3], STOCKS[o + 9], STOCKS[o + 15]);
    s.xt   = make_float3(STOCKS[o + 4], STOCKS[o + 10], STOCKS[o + 16]);
    s.kt   = make_float3(STOCKS[o + 5], STOCKS[o + 11], STOCKS[o + 17]);
    s.emax = make_float3(STOCKS[o + 6], STOCKS[o + 12], STOCKS[o + 18]);
    s.ks   = make_float3(STOCKS[o + 7], STOCKS[o + 13], STOCKS[o + 19]);
    s.halation = STOCKS[o + 20];
    s.grain = STOCKS[o + 21];
    return s;
}

// push / pull = development time [E: no Kodak push data in our set]:
// gamma x (1 + 0.12 push), toe speed 0.06 log E per stop, fog +0.02 D per stop pushed
__DEVICE__ Stock develop(Stock s, float push)
{
    s.g = scale3(s.g, 1.0f + 0.12f * push);
    s.xt = sub3(s.xt, make_float3(0.06f * push, 0.06f * push, 0.06f * push));
    if (push > 0.0f) s.dmin = add3(s.dmin, make_float3(0.02f * push, 0.02f * push, 0.02f * push));
    return s;
}

// scene Rec.2020 -> layer exposure: degree-3 root polynomial (exposure invariant)
__DEVICE__ float3 layer_exposure(float3 c, int set)
{
    if (set == SENS_NONE) return c;
    float r = _fmaxf(c.x, 0.0f), g = _fmaxf(c.y, 0.0f), b = _fmaxf(c.z, 0.0f);
    float t[13];
    t[0] = r; t[1] = g; t[2] = b;
    t[3] = _sqrtf(r * g); t[4] = _sqrtf(g * b); t[5] = _sqrtf(r * b);
    t[6] = _powf(r * g * g, 1.0f / 3.0f); t[7] = _powf(r * r * g, 1.0f / 3.0f);
    t[8] = _powf(g * b * b, 1.0f / 3.0f); t[9] = _powf(g * g * b, 1.0f / 3.0f);
    t[10] = _powf(r * b * b, 1.0f / 3.0f); t[11] = _powf(r * r * b, 1.0f / 3.0f);
    t[12] = _powf(r * g * b, 1.0f / 3.0f);
    int o = set * 39;
    float3 e = make_float3(0.0f, 0.0f, 0.0f);
    for (int i = 0; i < 13; i++) {
        e.x += RP[o + i] * t[i];
        e.y += RP[o + 13 + i] * t[i];
        e.z += RP[o + 26 + i] * t[i];
    }
    return e;
}

// exposure-equivalent density: straight line through the toe point, soft toe,
// soft shoulder at emax (times gamma = density above base)
__DEVICE__ float hd_curve(float x, float xt, float kt, float emax, float ks)
{
    float e = kt * softplus10((x - xt) / kt);
    return e - ks * softplus10((e - emax) / ks);
}

__DEVICE__ float3 sensitometry(float3 x, Stock s)
{
    return make_float3(s.dmin.x + s.g.x * hd_curve(x.x, s.xt.x, s.kt.x, s.emax.x, s.ks.x),
                       s.dmin.y + s.g.y * hd_curve(x.y, s.xt.y, s.kt.y, s.emax.y, s.ks.y),
                       s.dmin.z + s.g.z * hd_curve(x.z, s.xt.z, s.kt.z, s.emax.z, s.ks.z));
}

typedef struct {
    float interimage, saturation;
    float3 layer;
    float bleach;
} NegCtl;

__DEVICE__ float3 log_exposure(float3 e)
{
    return make_float3(_log10f(_fmaxf(e.x, 1e-7f) / GREY), _log10f(_fmaxf(e.y, 1e-7f) / GREY), _log10f(_fmaxf(e.z, 1e-7f) / GREY));
}

// layer log exposure -> Status M density of the developed negative
__DEVICE__ float3 develop_negative(float3 x, Stock s, NegCtl c)
{
    float3 D = sensitometry(x, s);
    if (s.sens != SENS_NONE) {
        // interimage on exposure-equivalent density: in the straight line the
        // same as coupling log exposures, fading in toe and shoulder
        float3 Dg = sensitometry(make_float3(0.0f, 0.0f, 0.0f), s);
        float3 u = make_float3((D.x - Dg.x) / s.g.x, (D.y - Dg.y) / s.g.y, (D.z - Dg.z) / s.g.z);
        float3 v = couple(u, c.interimage, INTERIMAGE);
        D = add3(D, make_float3(s.g.x * (v.x - u.x), s.g.y * (v.y - u.y), s.g.z * (v.z - u.z)));
        // film saturation: each layer's departure from the density it would
        // have for a neutral of the same visual exposure
        if (c.saturation != 1.0f) {
            float xn = 0.2627f * x.x + 0.6780f * x.y + 0.0593f * x.z;
            float3 Dn = sensitometry(make_float3(xn, xn, xn), s);
            D = add3(Dn, scale3(sub3(D, Dn), c.saturation));
        }
    }
    // layer density: dye amount of each layer above base
    return add3(s.dmin, make_float3((D.x - s.dmin.x) * c.layer.x, (D.y - s.dmin.y) * c.layer.y, (D.z - s.dmin.z) * c.layer.z));
}

// -----------------------------------------------------------------------------
//  Texture in the negative: halation (exposure) and grain (density)
// -----------------------------------------------------------------------------

__DEVICE__ unsigned int hash_u(unsigned int x)
{
    x ^= x >> 16; x *= 0x7feb352dU;
    x ^= x >> 15; x *= 0x846ca68bU;
    x ^= x >> 16;
    return x;
}

__DEVICE__ unsigned int hash3u(int x, int y, unsigned int s)
{
    return hash_u((unsigned int)x + hash_u((unsigned int)y + hash_u(s)));
}

__DEVICE__ float hash_gauss(int x, int y, unsigned int s)
{
    float a = (float)(hash3u(x, y, s) & 0x00FFFFFFU) * (2.0f / 16777215.0f) - 1.0f;
    float b = (float)(hash3u(x, y, s + 0x9e3779b9U) & 0x00FFFFFFU) * (2.0f / 16777215.0f) - 1.0f;
    float c = (float)(hash3u(x, y, s + 0x3c6ef372U) & 0x00FFFFFFU) * (2.0f / 16777215.0f) - 1.0f;
    return a + b + c;                                   // variance 1
}

__DEVICE__ float value_noise(float px, float py, float size, unsigned int s)
{
    float fx = px / size, fy = py / size;
    float ix = _floorf(fx), iy = _floorf(fy);
    float tx = fx - ix, ty = fy - iy;
    tx = tx * tx * (3.0f - 2.0f * tx);
    ty = ty * ty * (3.0f - 2.0f * ty);
    int x0 = (int)ix, y0 = (int)iy;
    float a = hash_gauss(x0, y0, s), b = hash_gauss(x0 + 1, y0, s);
    float c = hash_gauss(x0, y0 + 1, s), d = hash_gauss(x0 + 1, y0 + 1, s);
    float top = a + (b - a) * tx;
    return top + ((c + (d - c) * tx) - top) * ty;
}

// dye clouds: two octaves plus a fine component, about unit variance
__DEVICE__ float grain_noise(float px, float py, float size, unsigned int s)
{
    float n = 0.75f * value_noise(px, py, size, s)
            + 0.45f * value_noise(px + 17.3f, py - 9.1f, size * 0.55f, s ^ 0x51ed270bU)
            + 0.30f * hash_gauss((int)px, (int)py, s ^ 0xa3c59ac3U);
    return n * 0.85f;
}

__DEVICE__ unsigned int frame_seed(__TEXTURE__ tR, __TEXTURE__ tG, __TEXTURE__ tB, int w, int h, int animate)
{
    unsigned int seed = 0x1234567U;
    if (!animate) return seed;
    for (int j = 0; j < 4; j++) {
        for (int i = 0; i < 4; i++) {
            int sx = (int)(((float)i + 0.5f) * (float)w * 0.25f);
            int sy = (int)(((float)j + 0.5f) * (float)h * 0.25f);
            float v = _tex2D(tR, sx, sy) + _tex2D(tG, sx, sy) * 1.37f + _tex2D(tB, sx, sy) * 1.91f;
            seed = hash_u(seed ^ (unsigned int)(clampf(v, 0.0f, 16.0f) * 262143.0f));
        }
    }
    return seed;
}

// halation [E]: light that passes the emulsion reflects off the base and
// re-exposes the red layer (a little the green).  Exponential spread of about
// 0.09 mm of film; source = red-layer exposure of the neighbourhood.  Kodak's
// H&D curves are measured on large uniform fields, which already include
// their own halation, so only the departure from a uniform field is added:
// light moves from bright areas into their surroundings, flat areas stay.
// Returns the change of layer exposure.
__DEVICE__ float3 halation(__TEXTURE__ tR, __TEXTURE__ tG, __TEXTURE__ tB, int cx, int cy, int w, int h,
                           float3 redRow, float pxPerMM, float gain, int gamut, int gamma, int levels)
{
    float3 c0 = camera_to_scene(make_float3(_tex2D(tR, cx, cy), _tex2D(tG, cx, cy), _tex2D(tB, cx, cy)), gamut, gamma, levels);
    float centre = _fmaxf(redRow.x * c0.x + redRow.y * c0.y + redRow.z * c0.z, 0.0f);
    const int n = 32;
    float sigma = _fmaxf(0.09f * pxPerMM, 0.5f);
    float rot = (float)(hash3u(cx, cy, 0x5bd1e995U) & 0xFFFFU) * (6.2831853f / 65535.0f);
    float acc = 0.0f, wsum = 0.0f;
    for (int i = 0; i < n; i++) {
        float r = _sqrtf(((float)i + 0.5f) / (float)n) * 4.0f;
        float a = (float)i * GOLDEN + rot;
        int sx = clampi((int)((float)cx + _cosf(a) * r * sigma + 0.5f), 0, w - 1);
        int sy = clampi((int)((float)cy + _sinf(a) * r * sigma + 0.5f), 0, h - 1);
        float3 e = camera_to_scene(make_float3(_tex2D(tR, sx, sy), _tex2D(tG, sx, sy), _tex2D(tB, sx, sy)), gamut, gamma, levels);
        float wt = _expf(-r);
        acc += _fmaxf(redRow.x * e.x + redRow.y * e.y + redRow.z * e.z, 0.0f) * wt;
        wsum += wt;
    }
    float hv = gain * (acc / wsum - centre);
    return make_float3(hv, 0.25f * hv, 0.0f);
}

// grain [E]: independent dye clouds in each layer; the density spread grows
// with the developed density (more dye clouds) and with push
__DEVICE__ float3 add_grain(float3 D, float3 Dg, Stock s, float amount, float push, int x, int y, float pxPerMM, unsigned int seed)
{
    float size = _fmaxf(0.012f * pxPerMM, 0.6f);
    float px = (float)x, py = (float)y;
    unsigned int k = hash_u(seed ^ 0x27d4eb2fU);
    float sig = s.grain * amount * (1.0f + 0.25f * _fmaxf(push, 0.0f));
    float3 w = make_float3(_sqrtf(clampf((D.x - s.dmin.x) / _fmaxf(Dg.x - s.dmin.x, 0.05f), 0.0f, 4.0f)),
                           _sqrtf(clampf((D.y - s.dmin.y) / _fmaxf(Dg.y - s.dmin.y, 0.05f), 0.0f, 4.0f)),
                           _sqrtf(clampf((D.z - s.dmin.z) / _fmaxf(Dg.z - s.dmin.z, 0.05f), 0.0f, 4.0f)));
    return make_float3(D.x + sig * 1.0f * w.x * grain_noise(px, py, size, k ^ 0x165667b1U),
                       D.y + sig * 0.9f * w.y * grain_noise(px, py, size * 0.9f, k ^ 0xd3a2646cU),
                       D.z + sig * 1.3f * w.z * grain_noise(px, py, size * 1.15f, k ^ 0xfd7046c5U));
}

// -----------------------------------------------------------------------------
//  Printing and the 2383
// -----------------------------------------------------------------------------

typedef struct {
    int stock;
    float crosstalk, exposure, lightR, lightG, lightB, contrast, dyeSat, bleach, flare;
} PrintCtl;

typedef struct { float dmin, dmax, x0, k, s; } PrintCurve;

// light from the printer lamp through the negative, seen by the 2383 layers
__DEVICE__ float3 printer_exposure(float3 D, float silver, int set)
{
    int o = set * 9, w = set * NWL;
    float3 d = make_float3(D.x - NEG_DMIN_M[set * 3], D.y - NEG_DMIN_M[set * 3 + 1], D.z - NEG_DMIN_M[set * 3 + 2]);
    float3 a = make_float3(NEG_AINV[o] * d.x + NEG_AINV[o + 1] * d.y + NEG_AINV[o + 2] * d.z,
                           NEG_AINV[o + 3] * d.x + NEG_AINV[o + 4] * d.y + NEG_AINV[o + 5] * d.z,
                           NEG_AINV[o + 6] * d.x + NEG_AINV[o + 7] * d.y + NEG_AINV[o + 8] * d.z);
    float3 H = make_float3(0.0f, 0.0f, 0.0f);
    for (int i = 0; i < NWL; i++) {
        float t = exp10_f(-(a.x * NEG_DYE_C[w + i] + a.y * NEG_DYE_M[w + i] + a.z * NEG_DYE_Y[w + i] + silver));
        H.x += PRINT_W_R[w + i] * t; H.y += PRINT_W_G[w + i] * t; H.z += PRINT_W_B[w + i] * t;
    }
    return make_float3(_fmaxf(H.x, 1e-30f), _fmaxf(H.y, 1e-30f), _fmaxf(H.z, 1e-30f));
}

// 2383 characteristic curve: generalised (Richards) logistic, smooth
__DEVICE__ float print_curve(float x, PrintCurve c)
{
    return c.dmin + (c.dmax - c.dmin) * _powf(1.0f + _expf(-(x - c.x0) * c.k / c.s), -c.s);
}

__DEVICE__ float print_curve_inv(float D, PrintCurve c)
{
    D = clampf(D, c.dmin + 1e-4f, c.dmax - 1e-4f);
    float r = (c.dmax - c.dmin) / (D - c.dmin);
    return c.x0 - c.s / c.k * _logf(_powf(r, 1.0f / c.s) - 1.0f);
}

__DEVICE__ PrintCurve make_curve(float dmin, float dmax, float x0, float k, float s, PrintCtl c)
{
    PrintCurve p;
    p.dmin = dmin; p.dmax = dmax; p.x0 = x0; p.k = k * c.contrast; p.s = s;
    if (c.stock == PR_2393) { p.k *= 1.08f; p.dmax += 0.45f; }        // [E] no 2393 data
    return p;
}

// negative (and the normal-grey reference it is timed on) -> projected print light
__DEVICE__ float3 print_film(float3 D, float silver, float3 Dref, float silverRef, int set, PrintCtl c)
{
    PrintCurve pr = make_curve(PRINT_CURVE_R, c);
    PrintCurve pg = make_curve(PRINT_CURVE_G, c);
    PrintCurve pb = make_curve(PRINT_CURVE_B, c);
    float3 lad = make_float3(LAD);

    float3 H = printer_exposure(D, silver, set), Hg = printer_exposure(Dref, silverRef, set);
    float3 e = make_float3(_log10f(H.x / Hg.x), _log10f(H.y / Hg.y), _log10f(H.z / Hg.z));
    e = couple(e, c.crosstalk, PRINT_XTALK);
    float Dr = print_curve(e.x + print_curve_inv(lad.x, pr) + PT * (c.exposure + c.lightR), pr);
    float Dg = print_curve(e.y + print_curve_inv(lad.y, pg) + PT * (c.exposure + c.lightG), pg);
    float Db = print_curve(e.z + print_curve_inv(lad.z, pb) + PT * (c.exposure + c.lightB), pb);

    // print dye saturation: each layer's departure from a visual neutral of the
    // same density (cyan = red channel, magenta = green, yellow = blue)
    float Dn = (Dr + Dg + Db) * (1.0f / 3.0f), on = (lad.x + lad.y + lad.z) * (1.0f / 3.0f);
    Dr = Dn + (lad.x - on) + (Dr - Dn - (lad.x - on)) * c.dyeSat;
    Dg = Dn + (lad.y - on) + (Dg - Dn - (lad.y - on)) * c.dyeSat;
    Db = Dn + (lad.z - on) + (Db - Dn - (lad.z - on)) * c.dyeSat;

    float3 d = make_float3(Dr, Dg, Db);
    d = sub3(d, make_float3(PRINT_DMIN_A));
    float3 a = mul3(d, PRINT_AINV);
    float ps = c.bleach > 0.0f ? 0.6f * c.bleach * _fmaxf(Dn - 0.06f, 0.0f) : 0.0f;   // [E]
    float3 L = make_float3(0.0f, 0.0f, 0.0f);
    for (int i = 0; i < NWL; i++) {
        float t = exp10_f(-(a.x * PRINT_DYE_C[i] + a.y * PRINT_DYE_M[i] + a.z * PRINT_DYE_Y[i] + ps));
        L.x += PROJ_R[i] * t; L.y += PROJ_G[i] * t; L.z += PROJ_B[i] * t;
    }
    if (c.stock == PR_2383D60) L = make_float3(L.x, L.y * 0.951f, L.z * 0.875f);        // [E] warmer projector white
    else if (c.stock == PR_2383D55) L = make_float3(L.x, L.y * 0.895f, L.z * 0.746f);
    if (c.flare > 0.0f) {                                                              // [E] stray light
        float f = c.flare * 0.002f;
        L = make_float3((L.x + f) / (1.0f + f), (L.y + f) / (1.0f + f), (L.z + f) / (1.0f + f));
    }
    return L;
}

// -----------------------------------------------------------------------------
//  Display
// -----------------------------------------------------------------------------

// neutral reference DRT (no film): hue-preserving tonescale, grey -> SDR grey
__DEVICE__ float3 neutral_drt(float3 c)
{
    c = make_float3(_fmaxf(c.x, 0.0f), _fmaxf(c.y, 0.0f), _fmaxf(c.z, 0.0f));
    float n = _fmaxf(_fmaxf(c.x, c.y), c.z);
    if (n < 1e-7f) return make_float3(0.0f, 0.0f, 0.0f);
    float p = _powf(n, 1.2f);
    float t = 1.05f * p / (p + 1.039f);
    c = scale3(c, t / n);
    float Y = luma2020(c);
    float k = 1.0f - 0.6f * smooth01(0.6f, 1.05f, t);
    return make_float3(Y + (c.x - Y) * k, Y + (c.y - Y) * k, Y + (c.z - Y) * k);
}

__DEVICE__ float3 hdr_expand(float3 L, float peak, float grey)
{
    float Y = luma2020(L);
    if (Y <= 1e-7f) return scale3(L, grey / SDR_GREY);
    float y = _logf(Y / SDR_GREY), yw = _logf(1.0f / SDR_GREY);
    const float a = 8.0f;
    float k = (_logf(peak / grey) - yw) * a / (softplus_e(a * yw) - 0.69314718f);
    return scale3(L, grey * _expf(y + k * (softplus_e(a * y) - 0.69314718f) / a) / Y);
}

__DEVICE__ float pq_encode(float nits)
{
    float y = _powf(clampf(nits / 10000.0f, 0.0f, 1.0f), 0.1593017578125f);
    return _powf((0.8359375f + 18.8515625f * y) / (1.0f + 18.6875f * y), 78.84375f);
}

__DEVICE__ float hlg_oetf(float e)
{
    if (e <= 1.0f / 12.0f) return _sqrtf(3.0f * _fmaxf(e, 0.0f));
    return 0.17883277f * _logf(12.0f * e - 0.28466892f) + 0.55991073f;
}

__DEVICE__ float3 gamut_compress(float3 o, float Y)
{
    float mn = _fminf(o.x, _fminf(o.y, o.z));
    if (mn < 0.0f && Y > 0.0f) {
        float t = Y / (Y - mn);
        o = make_float3(Y + (o.x - Y) * t, Y + (o.y - Y) * t, Y + (o.z - Y) * t);
    }
    return o;
}

__DEVICE__ float3 encode_output(float3 L, int out, float peak, float grey)
{
    float Y = luma2020(L);
    if (out == OUT_PQ || out == OUT_HLG) {
        float3 n = hdr_expand(gamut_compress(L, Y), peak, grey);
        n = make_float3(_fmaxf(n.x, 0.0f), _fmaxf(n.y, 0.0f), _fmaxf(n.z, 0.0f));
        if (out == OUT_PQ) return make_float3(pq_encode(n.x), pq_encode(n.y), pq_encode(n.z));
        float g = 1.2f + 0.42f * _log10f(peak / 1000.0f);
        float3 d = scale3(n, 1.0f / peak);
        float3 sc = scale3(d, _powf(_fmaxf(luma2020(d), 1e-7f), 1.0f / g - 1.0f));
        return make_float3(hlg_oetf(sc.x), hlg_oetf(sc.y), hlg_oetf(sc.z));
    }
    float3 o;
    if (out == OUT_P3) o = mul3(L, 1.34357825f, -0.28217967f, -0.06139858f, -0.06529745f, 1.07578792f, -0.01049046f, 0.00282179f, -0.01959849f, 1.01677671f);
    else o = mul3(L, 1.66049100f, -0.58764114f, -0.07284986f, -0.12455047f, 1.13289990f, -0.00834942f, -0.01815076f, -0.10057890f, 1.11872966f);
    o = gamut_compress(o, Y);
    o = make_float3(clampf(o.x, 0.0f, 1.0f), clampf(o.y, 0.0f, 1.0f), clampf(o.z, 0.0f, 1.0f));
    float gm = out == OUT_SRGB ? 1.0f / 2.2f : (out == OUT_P3 ? 1.0f / 2.6f : 1.0f / 2.4f);
    return make_float3(_powf(o.x, gm), _powf(o.y, gm), _powf(o.z, gm));
}

// -----------------------------------------------------------------------------
//  Main
// -----------------------------------------------------------------------------

__DEVICE__ float3 transform(int p_Width, int p_Height, int p_X, int p_Y, __TEXTURE__ p_TexR, __TEXTURE__ p_TexG, __TEXTURE__ p_TexB)
{
    const float W = (float)p_Width, H = (float)p_Height;
    float frameMM = p_Format == FMT_65 ? 52.48f : (p_Format == FMT_S16 ? 12.52f : (p_Format == FMT_S8 ? 5.79f : 24.89f));
    float pxPerMM = W / frameMM;
    float gain = _exp2f(p_Exposure);
    float3 wb = wb_gains(p_Temp, p_Tint);

    Stock s0 = stock(p_Stock);
    Stock s = develop(s0, p_Push);
    NegCtl nc;
    nc.interimage = p_Interimage; nc.saturation = p_FilmSat;
    nc.layer = make_float3(p_LayerC, p_LayerM, p_LayerY);
    nc.bleach = p_NegBleach;

    PrintCtl pc;
    pc.stock = p_Print; pc.crosstalk = p_Crosstalk;
    pc.exposure = p_PrintExp; pc.lightR = p_PrintR; pc.lightG = p_PrintG; pc.lightB = p_PrintB;
    pc.contrast = p_PrintContrast; pc.dyeSat = p_DyeSat; pc.bleach = p_PrintBleach; pc.flare = p_Flare;

    // ---- Show Curve: a neutral grey ramp through the node, bottom left
    float bw = 0.32f * W, bh = 0.30f * H, bx = 0.03f * W, by = H - 0.04f * H - bh;
    float fx = ((float)p_X - bx) / bw, fy = 1.0f - ((float)p_Y - by) / bh;
    int inBox = p_ShowCurve && fx >= 0.0f && fx <= 1.0f && fy >= 0.0f && fy <= 1.0f;

    // ---- scene light: exposure and white balance before the film
    float3 E;
    if (inBox) {
        float g = GREY * _exp2f(-8.0f + 16.0f * fx);
        E = make_float3(g, g, g);
    } else {
        E = camera_to_scene(make_float3(_tex2D(p_TexR, p_X, p_Y), _tex2D(p_TexG, p_X, p_Y), _tex2D(p_TexB, p_X, p_Y)), p_InGamut, p_InGamma, p_Levels);
    }
    E = white_balance(scale3(E, gain), wb);

    // ---- negative: layer exposure (+ halation), development, grain
    float3 e = layer_exposure(E, s.sens);
    if (p_Halation > 0.0f && s.sens != SENS_NONE && !inBox) {
        int o = s.sens * 9;
        // red row of the 3x3 layer map, with exposure and white balance folded in
        float3 r0 = white_balance(make_float3(gain, 0.0f, 0.0f), wb);
        float3 r1 = white_balance(make_float3(0.0f, gain, 0.0f), wb);
        float3 r2 = white_balance(make_float3(0.0f, 0.0f, gain), wb);
        float3 row = make_float3(SENS3[o], SENS3[o + 1], SENS3[o + 2]);
        float3 red = make_float3(row.x * r0.x + row.y * r0.y + row.z * r0.z,
                                 row.x * r1.x + row.y * r1.y + row.z * r1.z,
                                 row.x * r2.x + row.y * r2.y + row.z * r2.z);
        float3 dh = halation(p_TexR, p_TexG, p_TexB, p_X, p_Y, p_Width, p_Height, red, pxPerMM, 0.02f * p_Halation * s.halation,
                             p_InGamut, p_InGamma, p_Levels);
        e = make_float3(_fmaxf(e.x + dh.x, 0.02f * e.x), _fmaxf(e.y + dh.y, 0.02f * e.y), e.z);
    }
    float3 x = log_exposure(e);
    float3 D = develop_negative(x, s, nc);
    // printer lights are set for a normally exposed, normally developed grey
    float3 Dref = develop_negative(make_float3(0.0f, 0.0f, 0.0f), s0, nc);
    float3 Dgrey = sensitometry(make_float3(0.0f, 0.0f, 0.0f), s);
    if (p_Grain > 0.0f && s.grain > 0.0f && !inBox)
        D = add_grain(D, Dgrey, s, p_Grain, p_Push, p_X, p_Y, pxPerMM, frame_seed(p_TexR, p_TexG, p_TexB, p_Width, p_Height, p_Animate));
    // negative bleach bypass [E]: silver stays with the dyes, half their density
    float silver = 0.5f * p_NegBleach * _fmaxf((D.x - s.dmin.x + D.y - s.dmin.y + D.z - s.dmin.z) * (1.0f / 3.0f), 0.0f);
    float silverRef = 0.5f * p_NegBleach * _fmaxf((Dref.x - s0.dmin.x + Dref.y - s0.dmin.y + Dref.z - s0.dmin.z) * (1.0f / 3.0f), 0.0f);

    // ---- output
    float3 res;
    if (p_DRT == DRT_CINEON) {
        res = make_float3((445.0f + (D.x - Dref.x) / 0.002f) / 1023.0f, (445.0f + (D.y - Dref.y) / 0.002f) / 1023.0f,
                          (445.0f + (D.z - Dref.z) / 0.002f) / 1023.0f);
    } else {
        // scan of the negative along each layer's straight line (for Neutral / Off)
        float3 scan = E;
        if (s.sens != SENS_NONE) {
            int o = s.sens * 9;
            float3 l = make_float3(GREY * exp10_f((D.x - Dref.x) / s0.g.x), GREY * exp10_f((D.y - Dref.y) / s0.g.y), GREY * exp10_f((D.z - Dref.z) / s0.g.z));
            // back to Rec.2020 through the inverse of the 3x3 layer map
            float a = SENS3[o], b = SENS3[o + 1], cc = SENS3[o + 2], d = SENS3[o + 3], ee = SENS3[o + 4], f = SENS3[o + 5], g = SENS3[o + 6], h = SENS3[o + 7], k = SENS3[o + 8];
            float det = a * (ee * k - f * h) - b * (d * k - f * g) + cc * (d * h - ee * g);
            scan = scale3(make_float3((ee * k - f * h) * l.x + (cc * h - b * k) * l.y + (b * f - cc * ee) * l.z,
                                      (f * g - d * k) * l.x + (a * k - cc * g) * l.y + (cc * d - a * f) * l.z,
                                      (d * h - ee * g) * l.x + (b * g - a * h) * l.y + (a * ee - b * d) * l.z), 1.0f / det);
        }
        if (p_DRT == DRT_OFF) res = scene_to_dwg_di(scan);
        else {
            float3 neutral = encode_output(neutral_drt(E), p_Output, p_HdrPeak, p_HdrGrey);
            if (p_DRT == DRT_NEUTRAL) res = encode_output(neutral_drt(scan), p_Output, p_HdrPeak, p_HdrGrey);
            else res = encode_output(print_film(D, silver, Dref, silverRef, s.dyes, pc), p_Output, p_HdrPeak, p_HdrGrey);
            if (p_Strength < 1.0f) res = mix3(neutral, res, p_Strength);
        }
    }

    if (inBox) {
        float stops = -8.0f + 16.0f * fx;
        float3 dot = make_float3(0.08f, 0.08f, 0.08f);
        float gx = _fabs(stops - 2.0f * _floorf(stops * 0.5f + 0.5f)) * bw / 16.0f;
        float gy = _fabs(fy * 4.0f - _floorf(fy * 4.0f + 0.5f)) * bh / 4.0f;
        if (gx < 0.6f || gy < 0.6f) dot = make_float3(0.18f, 0.18f, 0.18f);
        if (_fabs(stops) * bw / 16.0f < 0.8f) dot = make_float3(0.32f, 0.32f, 0.32f);
        float w = 1.6f / bh;
        if (_fabs(res.z - fy) < w) dot = make_float3(0.25f, 0.45f, 1.0f);
        if (_fabs(res.y - fy) < w) dot = make_float3(0.2f, 0.9f, 0.3f);
        if (_fabs(res.x - fy) < w) dot = make_float3(1.0f, 0.25f, 0.2f);
        res = dot;
    }
    return res;
}
