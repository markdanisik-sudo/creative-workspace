        s.dmin = make_float3(0.225449f, 0.618194f, 0.913884f); s.g = make_float3(0.591876f, 0.67373f, 0.653235f); s.xt = make_float3(-1.17826f, -1.21857f, -1.24644f);
        s.kt = make_float3(0.288002f, 0.228172f, 0.389684f); s.emax = make_float3(3.13276f, 3.18167f, 3.28701f); s.ks = make_float3(0.798581f, 0.573326f, 0.773002f);
        s.mat = 2; s.cd = 1.0f;
