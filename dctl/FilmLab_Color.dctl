        s.dmin = make_float3(0.173916f, 0.575303f, 0.845082f); s.g = make_float3(0.510868f, 0.586965f, 0.566182f); s.xt = make_float3(-1.12f, -1.12f, -1.12f);
        s.kt = make_float3(0.22f, 0.22f, 0.22f); s.emax = make_float3(3.1f, 3.1f, 3.1f); s.ks = make_float3(0.28f, 0.28f, 0.28f);
