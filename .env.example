# Supabase project (Settings → API). For local dev, `npx supabase start` prints these.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# tldraw license key: required for production domains, not for localhost.
# https://tldraw.dev/pricing
NEXT_PUBLIC_TLDRAW_LICENSE_KEY=
